game/assets/mm/**/*.png filter=lfs diff=lfs merge=lfs -text
game/assets/original/**/*.glb filter=lfs diff=lfs merge=lfs -text
game/assets/original/**/*.png filter=lfs diff=lfs merge=lfs -text
game/assets/original/**/*.res filter=lfs diff=lfs merge=lfs -text
game/assets/original/**/*.exr filter=lfs diff=lfs merge=lfs -text
