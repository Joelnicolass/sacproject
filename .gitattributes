game/assets/cc0/**/*.jpg filter=lfs diff=lfs merge=lfs -text
game/assets/cc0/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
game/assets/cc0/**/*.webp filter=lfs diff=lfs merge=lfs -text
game/assets/cc0/**/*.exr filter=lfs diff=lfs merge=lfs -text
game/assets/cc0/**/*.hdr filter=lfs diff=lfs merge=lfs -text
game/assets/cc0/**/*.glb filter=lfs diff=lfs merge=lfs -text
