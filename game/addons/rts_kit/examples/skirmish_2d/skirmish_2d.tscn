[node name="Hud" type="CanvasLayer" parent="."]

[node name="View" type="Control" parent="Hud"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="Panel" parent="Hud/View"]
visible = false
layout_mode = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_box")

[node name="Status" type="Label" parent="Hud"]
offset_left = 16.0
offset_top = 12.0
offset_right = 400.0
offset_bottom = 36.0
mouse_filter = 2
text = "Nothing selected"

[node name="Help" type="Label" parent="Hud"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -170.0
offset_right = 800.0
offset_bottom = -12.0
grow_vertical = 0
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "Left: select (drag: box, Shift: add, Ctrl/Cmd or double click: same kind)
Right: order   Panel (bottom right): every order with the mouse
A / G / M: arm attack / guard / move, then left click   R: retreat   Alt+1..8: formation
Ctrl/Cmd+1..0: store a group   1..0: recall   Shift+1..0: add to it
Arrows / screen edges / middle drag: pan   Wheel: zoom   F: follow the hero / free camera"

[node name="CommandCard" type="GridContainer" parent="Hud" node_paths=PackedStringArray("order_input", "command_input")]
editor_description = "The kit's command panel: a button per command and formation of the catalogs, with its key. The no-menu way to give every order with the mouse."
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -380.0
offset_top = -250.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 0
grow_vertical = 0
columns = 3
script = ExtResource("16_card")
order_input = NodePath("../../Command/OrderInput")
command_input = NodePath("../../Command")


[node name="Cue" parent="Hud" node_paths=PackedStringArray("state", "probe") instance=ExtResource("17_cue")]
