[node name="Skirmish2D" type="Node2D"]
editor_description = "RtsKit's 2D example, with no radial menu: the right button is a plain right click and the command panel gives every order with the mouse. Command: the kit's rig, every piece wired in the inspector. Units: spawned by the script (RtsUnit + RtsExampleWalker). Hud/View takes the world's clicks."
script = ExtResource("1_main")

[node name="Units" type="Node2D" parent="."]

[node name="Camera" type="Camera2D" parent="." node_paths=PackedStringArray("edge_area")]
script = ExtResource("2_camera")
edge_area = NodePath("../Hud/View")
bounds = Rect2(-1000, -600, 2000, 1200)

[node name="Ping" type="Node2D" parent="." node_paths=PackedStringArray("order_input")]
script = ExtResource("3_ping")
