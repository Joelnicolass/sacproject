{
  "scene": "res://scenes/ui/boot.tscn",
  "wait_first": 1.0,
  "steps": [
    { "click": "%Play" },
    { "click": "%Join" },
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 20 } },
    { "wait_until": { "node": "%Watch", "prop": "foe_was_visible", "equals": true, "timeout": 40 } },
    { "wait_until": { "node": "%Watch", "prop": "foe_hidden", "equals": true, "timeout": 20 } },
    { "assert": { "node": "%Watch", "prop": "foe_stealth", "equals": true } },
    { "assert": { "node": "%Watch", "prop": "foe_fade", "gte": 0.7 } },
    { "print": { "node": "%Watch", "prop": "foe_fade" } }
  ]
}
