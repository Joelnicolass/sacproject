{
  "scene": "res://debug/map/mana_fount.tscn",
  "wait_first": 1.5,
  "steps": [
    { "wait": 2.2 },
    { "print": { "node": "/root/ManaFount/HighNoon/Map/MapProps/Founts/FountEast", "prop": "global_position" } },
    { "print": { "node": "/root/ManaFount/HighNoon/Map/MapProps/Starts/Start1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%ManaProbe", "prop": "text" } },
    { "assert": { "node": "%ManaProbe", "text_contains": "Maná 200 " } },
    { "assert": { "node": "%ManaProbe", "text_contains": "sin fuente" } },
    { "assert": { "node": "%Stats", "text_contains": "Maná 200/1000" } },
    { "shot": "f22pt_01_far_start.png" },

    { "wait": 3.0 },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "print": { "node": "%ManaProbe", "prop": "text" } },
    { "assert": { "node": "%ManaProbe", "text_contains": "Maná 200 " } },
    { "assert": { "node": "%ManaProbe", "text_contains": "sin fuente" } },
    { "assert": { "node": "%Stats", "text_contains": "Maná 200/1000" } },
    { "shot": "f22pt_02_far_5s.png" },

    { "press": { "name": "move_forward", "hold": 3.0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "wait": 0.1 },
    { "assert": { "node": "%Stats", "text_contains": "Maná 200/1000" } },
    { "shot": "f22pt_03_walking_toward.png" },

    { "press": { "name": "move_forward", "hold": 5.0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "shot": "f22pt_04_arrived.png" },
    { "wait": 1.0 },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "wait": 3.0 },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%ManaProbe", "prop": "text" } },
    { "wait": 0.1 },
    { "assert": { "node": "%ManaProbe", "text_contains": "· manantial" } },
    { "shot": "f22pt_05_near_rising.png" },

    { "press": { "name": "turn_left", "hold": 1.0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "rotation" } },
    { "shot": "f22pt_06_turned.png" },
    { "press": { "name": "move_forward", "hold": 4.0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "wait": 2.2 },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "wait": 3.0 },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%ManaProbe", "prop": "text" } },
    { "wait": 0.1 },
    { "assert": { "node": "%ManaProbe", "text_contains": "sin fuente" } },
    { "shot": "f22pt_07_walked_away.png" },

    { "scene": "res://scenes/match/high_noon.tscn" },
    { "wait": 3.0 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "maximum" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Maná 1000/1000" } },
    { "shot": "f22pt_08_high_noon_spawn.png" },
    { "wait": 5.0 },
    { "print": { "node": "%Wizards/Wizard1/ManaPool", "prop": "current" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Maná 1000/1000" } },
    { "shot": "f22pt_09_high_noon_8s.png" }
  ]
}
