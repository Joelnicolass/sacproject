{
  "scene": "res://debug/spells/cast_heal.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 10 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "/1500 · Maná 1000/1000 · Almas 12" } },
    { "assert": { "node": "%SpellBook", "visible": true } },
    { "shot": "f24_0_start.png" },
    { "press": "spell_3" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "press": "select" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Heal" } },
    { "wait": 0.8 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "f24_1_heal.png" },
    { "wait": 4.2 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_equals": "Vida 1500/1500 · Maná 700/1000 · Almas 12" } },
    { "press": { "name": "turn_left", "hold": 0.2 } },
    { "wait": 0.5 },
    { "call": { "harness": "selection_probe", "method": "aim_body", "args": ["Nmuh1", 1.5] } },
    { "wait": 0.3 },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "press": "select" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "wait": 0.9 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "shot": "f24_2_rock.png" },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Enfriando" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_equals": "Vida 1500/1500 · Maná 400/1000 · Almas 12" } },
    { "shot": "f24_3_cooling.png" },
    { "wait": 8.2 },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Enfriando" } },
    { "wait": 1.0 },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "press": "select" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "wait": 3.6 },
    { "press": "spell_1" },
    { "wait": 0.1 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Battle", "text_equals": "Sin maná" } },
    { "assert": { "node": "%Stats", "text_equals": "Vida 1500/1500 · Maná 100/1000 · Almas 12" } },
    { "shot": "f24_4_no_mana.png" },
    { "press": { "name": "zoom_in", "hold": 0.6 } },
    { "wait": 0.6 },
    { "print": { "node": "%Camera", "prop": "zoom" } },
    { "shot": "f24_5_zoom0.png" }
  ]
}
