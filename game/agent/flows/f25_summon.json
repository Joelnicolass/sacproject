{
  "scene": "res://debug/units/summon_unit.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 10 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_equals": "Vida 1500/1500 · Maná 1000/1000 · Almas 12" } },
    { "assert": { "node": "%SpellBook", "visible": true } },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 0 } },
    { "shot": "f25_0_start.png" },
    { "press": "creature_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Trogg" } },
    { "print": { "node": "%Units/Trogg1", "prop": "mode" } },
    { "print": { "node": "%Units/Trogg1/Tilt/Mesh", "prop": "transparency" } },
    { "shot": "f25_1_casting.png" },
    { "wait": 0.6 },
    { "print": { "node": "%Units/Trogg1", "prop": "mode" } },
    { "print": { "node": "%Units/Trogg1", "prop": "model" } },
    { "print": { "node": "%Units/Trogg1/Tilt/Mesh", "prop": "model" } },
    { "print": { "node": "%SelectionRoster", "prop": "summary" } },
    { "assert": { "node": "%SelectionRoster", "prop": "summary", "equals": "Trogg 960/960" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_equals": "Vida 1500/1500 · Maná 700/1000 · Almas 11" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Units/Trogg1", "prop": "global_position" } },
    { "shot": "f25_2_trogg.png" },
    { "press": "order_units" },
    { "wait": 1.0 },
    { "print": { "node": "%Units/Trogg1", "prop": "global_position" } },
    { "assert": { "node": "%Battle", "text_equals": "Orden" } },
    { "shot": "f25_3_walk.png" },
    { "press": "creature_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Enfriando" } },
    { "wait": 2.8 },
    { "press": "creature_1" },
    { "wait": 0.4 },
    { "print": { "node": "%SelectionRoster", "prop": "summary" } },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 2 } },
    { "print": { "node": "%Units/Manahoar1", "prop": "model" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_equals": "Vida 1500/1500 · Maná 699/1000 · Almas 10" } },
    { "shot": "f25_4_manahoar.png" }
  ]
}
