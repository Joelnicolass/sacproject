    { "assert": { "node": "%Battle", "text_equals": "Mago" } },
    { "shot": "f27_0_start.png" },
    { "press": "check_tick" },
    { "wait": 0.2 },
    { "print": { "node": "%OrdersLog", "prop": "text" } },
    { "print": { "node": "%SelectionRoster", "prop": "summary" } },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 4 } },
    { "assert": { "node": "%Battle", "text_equals": "4 unidades" } },
    { "shot": "f27_1_selected.png" },
    { "press": "group_set_1" },
    { "wait": 0.1 },
    { "drag": { "node": "%View", "from_x": 160, "from_y": 200, "to_x": 260, "to_y": 260 } },
    { "wait": 0.2 },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 0 } },
    { "assert": { "node": "%Battle", "text_equals": "Mago" } },
    { "press": "group_1" },
    { "wait": 0.1 },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 4 } },
    { "press": "order_units" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Ataque" } },
    { "wait": 0.4 },
    { "print": { "node": "%OrdersLog", "prop": "text" } },
    { "assert": { "node": "%OrdersLog", "text_contains": "atacan 4" } },
    { "print": { "node": "Arena/Trogg1", "prop": "mode" } },
    { "print": { "node": "Arena/Trogg4", "prop": "mode" } },
    { "wait": 2.5 },
    { "shot": "f27_2_charge.png" },
    { "wait_until": { "node": "%OrdersLog", "text_contains": "muere Druid", "timeout": 40 } },
    { "print": { "node": "%OrdersLog", "prop": "text" } },
    { "wait": 1.0 },
    { "shot": "f27_3_dead.png" }
  ]
