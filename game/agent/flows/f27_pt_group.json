{
  "scene": "res://debug/orders/orders_group.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%OrdersLog", "text_contains": "Druid 800/800", "timeout": 10 } },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg1", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg2", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg3", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg4", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg1/HealthBar", "prop": "visible" } },
    { "print": { "node": "Arena/Druid1/HealthBar", "prop": "visible" } },
    { "shot": "f27pt_g0_start.png" },

    { "drag": { "node": "%View", "from_x": 560, "from_y": 330, "to_x": 720, "to_y": 450 } },
    { "wait": 0.2 },
    { "print": { "node": "%SelectionRoster", "prop": "summary" } },
    { "print": { "node": "%SelectionRoster", "prop": "count" } },
    { "print": { "node": "%SelectionBox", "prop": "visible" } },
    { "shot": "f27pt_g1_dragrect.png" },

    { "drag": { "node": "%View", "from_x": 160, "from_y": 200, "to_x": 260, "to_y": 260 } },
    { "wait": 0.2 },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 0 } },
    { "print": { "node": "Arena/Trogg1/HealthBar", "prop": "visible" } },

    { "press": "check_tick" },
    { "wait": 0.2 },
    { "print": { "node": "%OrdersLog", "prop": "text" } },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 4 } },
    { "assert": { "node": "%Battle", "text_equals": "4 unidades" } },
    { "print": { "node": "Arena/Trogg1/HealthBar", "prop": "visible" } },
    { "print": { "node": "Arena/Trogg2/HealthBar", "prop": "visible" } },
    { "print": { "node": "Arena/Trogg3/HealthBar", "prop": "visible" } },
    { "print": { "node": "Arena/Trogg4/HealthBar", "prop": "visible" } },
    { "print": { "node": "%SelectionBox", "prop": "visible" } },
    { "shot": "f27pt_g2_enter.png" },

    { "press": "group_set_1" },
    { "wait": 0.1 },
    { "drag": { "node": "%View", "from_x": 160, "from_y": 200, "to_x": 260, "to_y": 260 } },
    { "wait": 0.2 },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 0 } },
    { "assert": { "node": "%Battle", "text_equals": "Mago" } },
    { "print": { "node": "Arena/Trogg1/HealthBar", "prop": "visible" } },
    { "print": { "node": "Arena/Trogg4/HealthBar", "prop": "visible" } },
    { "shot": "f27pt_g3_deselected.png" },
    { "press": "group_1" },
    { "wait": 0.1 },
    { "assert": { "node": "%SelectionRoster", "prop": "count", "equals": 4 } },
    { "print": { "node": "Arena/Trogg1/HealthBar", "prop": "visible" } },
    { "print": { "node": "Arena/Trogg4/HealthBar", "prop": "visible" } },
    { "shot": "f27pt_g4_group1.png" },

    { "press": "order_units" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Ataque" } },
    { "wait": 0.4 },
    { "assert": { "node": "%OrdersLog", "text_contains": "atacan 4" } },
    { "wait": 2.5 },
    { "shot": "f27pt_g5_charge.png" },
    { "wait_until": { "node": "%OrdersLog", "text_contains": "muere Druid", "timeout": 40 } },
    { "print": { "node": "%OrdersLog", "prop": "text" } },
    { "wait": 1.0 },
    { "print": { "node": "Arena/Trogg1", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg2", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg3", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg4", "prop": "global_position" } },
    { "shot": "f27pt_g6_dead.png" },

    { "press": "order_retreat" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Retirada" } },
    { "wait": 2.0 },
    { "print": { "node": "Arena/Trogg1", "prop": "global_position" } },
    { "shot": "f27pt_g7_retreating.png" },
    { "wait": 6.0 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg1", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg2", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg3", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg4", "prop": "global_position" } },
    { "print": { "node": "Arena/Trogg1", "prop": "mode" } },
    { "shot": "f27pt_g8_retreated.png" }
  ]
}
