    { "shot": "f28_2_flying.png" },
    { "wait_until": { "node": "%HitLog", "text_contains": "dano Druid 650 vida 150", "timeout": 6 } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "assert": { "node": "%HitLog", "text_contains": "Druid 150/800" } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } },
    { "shot": "f28_3_druid_hit.png" },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "cooling" } },
    { "wait": 8.0 },
    { "repeat": {
        "times": 40,
        "until": { "node": "%HitLog", "text_contains": "mira Trogg" },
        "steps": [ { "press": { "name": "zoom_in", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "wait_until": { "node": "%HitLog", "text_contains": "Trogg inmune", "timeout": 6 } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } },
    { "shot": "f28_4_trogg_immune.png" },
    { "wait": 9.6 },
    { "repeat": {
        "times": 60,
        "until": { "node": "%HitLog", "text_contains": "mira suelo" },
        "steps": [ { "press": { "name": "zoom_in", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "bad_target" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } },
    { "shot": "f28_5_ground_invalid.png" },
    { "repeat": {
        "times": 60,
        "until": { "node": "%HitLog", "text_contains": "mira Trogg" },
        "steps": [ { "press": { "name": "zoom_out", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "click": "%View" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "shot": "f28_6_still_armed.png" }
  ]
