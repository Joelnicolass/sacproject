    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "wait": 0.35 },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "shot": "f28_1_rising.png" },
    { "wait": 0.6 },
