{
  "scene": "res://scenes/ui/boot.tscn",
  "wait_first": 0.8,
  "steps": [
    { "click": "%Play" },
    { "click": "%Join" },
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 15 } },
    { "wait": 1.0 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Almas 12" } },
    { "shot": "f30_pt_online_01_start.png" },

    { "press": "creature_2" },
    { "wait_until": { "node": "%Battle", "text_equals": "Trogg", "timeout": 3 } },
    { "wait_until": { "node": "%Stats", "text_contains": "Almas 11", "timeout": 3 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%Units/Trogg1", "prop": "owner_slot" } },
    { "shot": "f30_pt_online_02_summon.png" },

    { "press": "drop_soul" },
    { "wait_until": { "node": "%Stats", "text_contains": "Almas 10", "timeout": 3 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait": 1.2 },
    { "shot": "f30_pt_online_03_drop.png" },
    { "wait_until": { "node": "%Stats", "text_contains": "Almas 11", "timeout": 4 } },
    { "print": { "node": "%Stats", "prop": "text" } },

    { "press": "drop_soul" },
    { "wait_until": { "node": "%Stats", "text_contains": "Almas 10", "timeout": 3 } },
    { "press": { "name": "move_backward", "hold": 1.5 } },
    { "wait": 3.5 },
    { "assert": { "node": "%Stats", "text_contains": "Almas 10" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "shot": "f30_pt_online_04_left.png" }
  ]
}
