{
  "scene": "res://debug/sacrifice/soul_pickup.tscn",
  "wait_first": 1.5,
  "steps": [
    { "wait": 1.0 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "print": { "node": "FreeSoul", "prop": "position" } },
    { "print": { "node": "FreeSoul", "prop": "state" } },
    { "assert": { "node": "%Stats", "text_contains": "Almas 0" } },
    { "shot": "f30_pt_01_start.png" },

    { "press": "drop_soul" },
    { "wait": 0.2 },
    { "assert": { "node": "%CommandCue/Invalid", "visible": true } },
    { "assert": { "node": "%Battle", "text_contains": "no_souls" } },
    { "assert": { "node": "%Stats", "text_contains": "Almas 0" } },
    { "shot": "f30_pt_02_sin_almas.png" },

    { "press": { "name": "move_forward", "pressed": true } },
    { "wait": 1.2 },
    { "assert": { "node": "%Stats", "text_contains": "Almas 0" } },
    { "shot": "f30_pt_03_approach.png" },
    { "repeat": {
        "times": 200,
        "until": { "node": "%Stats", "text_contains": "Almas 1" },
        "steps": [ { "wait": 0.02 } ]
    } },
    { "press": { "name": "move_forward", "pressed": false } },
    { "shot": "f30_pt_04_shrink_a.png" },
    { "print": { "node": "FreeSoul", "prop": "scaling" } },
    { "print": { "node": "FreeSoul", "prop": "position" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "shot": "f30_pt_05_shrink_b.png" },
    { "wait": 0.5 },
    { "assert": { "node": "FreeSoul", "visible_in_tree": false } },
    { "assert": { "node": "%Stats", "text_contains": "Almas 1" } },
    { "shot": "f30_pt_06_collected.png" },

    { "press": "drop_soul" },
    { "wait": 0.3 },
    { "assert": { "node": "%Stats", "text_contains": "Almas 0" } },
    { "print": { "node": "%Souls/Soul1", "prop": "position" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "print": { "node": "%Souls/Soul1", "prop": "scaling" } },
    { "wait": 0.9 },
    { "shot": "f30_pt_07_drop_1s.png" },
    { "print": { "node": "%Souls/Soul1", "prop": "scaling" } },
    { "wait": 1.3 },
    { "assert": { "node": "%Stats", "text_contains": "Almas 0" } },
    { "print": { "node": "%Souls/Soul1", "prop": "scaling" } },
    { "wait_until": { "node": "%Stats", "text_contains": "Almas 1", "timeout": 2.0 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait": 0.5 },
    { "assert": { "node": "%Souls/Soul1", "visible_in_tree": false } },
    { "shot": "f30_pt_08_recollected.png" },

    { "press": "drop_soul" },
    { "wait": 0.1 },
    { "assert": { "node": "%Stats", "text_contains": "Almas 0" } },
    { "press": { "name": "move_backward", "hold": 1.5 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "print": { "node": "%Souls/Soul2", "prop": "position" } },
    { "wait": 3.5 },
    { "assert": { "node": "%Stats", "text_contains": "Almas 0" } },
    { "assert": { "node": "%Souls/Soul2", "visible_in_tree": true } },
    { "print": { "node": "%Souls/Soul2", "prop": "state" } },
    { "print": { "node": "%Souls/Soul2", "prop": "scaling" } },
    { "print": { "node": "%Souls/Soul2", "prop": "collector_slot" } },
    { "print": { "node": "%Souls/Soul2", "prop": "position" } },
    { "shot": "f30_pt_09_left_behind.png" },
    { "press": { "name": "move_forward", "pressed": true } },
    { "repeat": {
        "times": 200,
        "until": { "node": "%Stats", "text_contains": "Almas 1" },
        "steps": [ { "wait": 0.02 } ]
    } },
    { "press": { "name": "move_forward", "pressed": false } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "shot": "f30_pt_10_walk_back_collect.png" },
    { "print": { "node": "%Stats", "prop": "text" } }
  ]
}
