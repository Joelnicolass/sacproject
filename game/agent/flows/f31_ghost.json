{
  "scene": "res://debug/wizard_ghost.tscn",
  "wait_first": 1.5,
  "steps": [
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%GhostState", "visible": false } },
    { "shot": "f31_start.png" },
    { "wait_until": { "node": "%GhostState", "visible": true, "timeout": 20 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Vida 0/1500 · Maná 0/1000" } },
    { "assert": { "node": "%GhostState", "text_equals": "Fantasma" } },
    { "wait": 2.0 },
    { "print": { "node": "%Wizards/Wizard1/Mesh", "prop": "transparency" } },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "Druid", "prop": "mode" } },
    { "shot": "f31_ghost.png" },
    { "press": "spell_3" },
    { "wait": 0.3 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "press": { "name": "move_forward", "hold": 6.5 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "wait": 1.0 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "f31_fount.png" },
    { "wait_until": { "node": "%Stats", "text_contains": "Vida 1500/1500", "timeout": 15 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait_until": { "node": "%GhostState", "visible": false, "timeout": 3 } },
    { "wait": 0.3 },
    { "print": { "node": "%Wizards/Wizard1/Mesh", "prop": "transparency" } },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "Druid", "prop": "mode" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "shot": "f31_revived.png" }
  ]
}
