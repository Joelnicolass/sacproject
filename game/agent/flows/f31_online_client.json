{
  "scene": "res://scenes/ui/boot.tscn",
  "wait_first": 0.8,
  "steps": [
    { "click": "%Play" },
    { "click": "%Join" },
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 15 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait_until": { "node": "%GhostState", "visible": true, "timeout": 25 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Vida 0/1950" } },
    { "wait": 2.0 },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "%Wizards/Wizard1/Tilt/Mesh", "prop": "transparency" } },
    { "print": { "node": "Druid", "prop": "mode" } },
    { "shot": "f31_online_ghost.png" },
    { "press": { "name": "move_forward", "hold": 6.5 } },
    { "wait": 0.5 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "wait_until": { "node": "%Stats", "text_contains": "Vida 1950/1950", "timeout": 24 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait_until": { "node": "%GhostState", "visible": false, "timeout": 3 } },
    { "wait": 0.3 },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "%Wizards/Wizard1/Tilt/Mesh", "prop": "transparency" } },
    { "shot": "f31_online_revived.png" }
  ]
