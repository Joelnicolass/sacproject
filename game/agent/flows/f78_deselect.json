    {
      "wait_until": {
        "node": "%OrdersLog",
        "text_contains": "Druid 800/800",
        "timeout": 25
      }
    },
    {
      "assert": {
        "node": "%OrdersLog",
        "text_contains": "150 propias"
      }
    },
    {
      "press": "check_tick"
    },
    {
      "wait": 0.3
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 150
      }
    },
    {
      "call": {
        "harness": "selection_probe",
        "method": "aim_empty"
      }
    },
    {
      "press": "select"
    },
    {
      "wait": 0.2
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 0
      }
    },
    {
      "assert": {
        "node": "Group",
        "prop": "bars_count",
        "equals": 0
      }
    },
    {
      "shot": "f78_3_cleared.png"
    },
    {
      "press": "check_tick"
    },
    {
      "wait": 0.3
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 150
      }
    },
    {
      "call": {
        "harness": "selection_probe",
