    {
      "wait": 0.1
    },
    {
      "call": {
        "harness": "selection_probe",
        "method": "aim_empty"
      }
    },
    {
      "press": "select"
    },
    {
      "wait": 0.2
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 0
