    {
      "press": "select"
    },
    {
      "wait": 0.2
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 150
      }
    },
    {
      "call": {
        "harness": "selection_probe",
        "method": "aim_body",
        "args": [
          "Wizard1"
        ]
      }
    },
    {
      "press": "select"
    },
    {
      "wait": 0.2
    },
    {
      "assert": {
