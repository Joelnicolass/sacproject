{
  "scene": "res://debug/orders/selection_many.tscn",
  "wait_first": 2.5,
  "steps": [
    {
      "wait_until": {
        "node": "%OrdersLog",
        "text_contains": "Druid 800/800",
        "timeout": 25
      }
    },
    {
      "assert": {
        "node": "%OrdersLog",
        "text_contains": "150 propias"
      }
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 0
      }
    },
    {
      "assert": {
        "node": "Group",
        "prop": "bars_count",
        "equals": 0
      }
    },
    {
      "call": {
        "harness": "selection_probe",
        "method": "under",
        "args": [
          800,
          560
        ]
      }
    },
    {
      "shot": "f78_0_start.png"
    },
    {
      "press": "check_tick"
    },
    {
      "wait": 0.3
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 150
      }
    },
    {
      "assert": {
        "node": "Group",
        "prop": "sel_count",
        "equals": 150
      }
    },
    {
      "assert": {
        "node": "Group",
        "prop": "bars_count",
        "equals": 150
      }
    },
    {
      "assert": {
        "node": "%OrdersLog",
        "text_contains": "sel 150"
      }
    },
    {
      "print": {
        "node": "Group",
        "prop": "rect_us"
      }
    },
    {
      "assert": {
        "node": "Group",
        "prop": "rect_us",
        "lte": 4000
      }
    },
    {
      "shot": "f78_1_sel150.png"
    },
    {
      "call": {
        "harness": "selection_probe",
        "method": "aim_empty"
      }
    },
    {
      "press": "order_units"
    },
    {
      "wait": 0.3
    },
    {
      "wait_until": {
        "node": "Group",
        "prop": "ordered_count",
        "equals": 150,
        "timeout": 5
      }
    },
    {
      "print": {
        "node": "%Orders",
        "prop": "last_rows"
      }
    },
    {
      "print": {
        "node": "%Orders",
        "prop": "last_width"
      }
    },
    {
      "print": {
        "node": "%Orders",
        "prop": "last_apply_us"
      }
    },
    {
      "assert": {
        "node": "%Orders",
        "prop": "last_rows",
        "equals": 13
      }
    },
    {
      "assert": {
        "node": "%Orders",
        "prop": "last_apply_us",
        "gte": 0
      }
    },
    {
      "assert": {
        "node": "%OrdersLog",
        "text_contains": "filas 13"
      }
    },
    {
      "print": {
        "node": "%OrdersLog",
        "prop": "text"
      }
    },
    {
      "wait": 6.0
    },
    {
      "shot": "f78_2_order_rows.png"
    },
    {
      "print": {
        "node": "%Orders",
        "prop": "last_apply_us"
      }
    },
    {
      "call": {
        "harness": "selection_probe",
        "method": "aim_empty"
      }
    },
    {
      "press": "order_units"
    },
    {
      "wait": 0.3
    },
    {
      "print": {
        "node": "%Orders",
        "prop": "last_apply_us"
      }
    },
    {
      "assert": {
        "node": "%Orders",
        "prop": "last_apply_us",
        "lte": 12000
      }
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 150
      }
    }
  ]
}