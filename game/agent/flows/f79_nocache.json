{
  "scene": "res://debug/orders_group.tscn",
  "wait_first": 2.0,
  "steps": [
    {"wait_until": {"node": "%OrdersLog", "text_contains": "Druid 800/800", "timeout": 25}},
    {"call": {"harness": "hud_cache_probe", "method": "hide_cache"}},
    {"press": "check_tick"},
    {"wait": 0.4},
    {"assert": {"node": "%SelectionRoster", "prop": "count", "equals": 4}},
    {"assert": {"node": "%SelectionRoster", "prop": "mode", "equals": "unit"}},
    {"assert": {"node": "%SelectionRoster/Frame", "prop": "name", "equals": "Frame"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "prop": "text", "equals": "ycro"}},
    {"shot": "f79_nocache.png"},
    {"call": {"harness": "hud_cache_probe", "method": "restore_cache"}},
    {"wait": 0.3},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "prop": "text", "equals": ""}}
  ]
}
