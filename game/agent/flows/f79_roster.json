{
  "scene": "res://debug/orders_group.tscn",
  "wait_first": 2.0,
  "steps": [
    {"wait_until": {"node": "%OrdersLog", "text_contains": "Druid 800/800", "timeout": 25}},
    {"assert": {"node": "%SelectionRoster", "visible": true}},
    {"assert": {"node": "%SelectionRoster", "prop": "count", "equals": 0}},
    {"assert": {"node": "%SelectionRoster", "prop": "mode", "equals": "unit"}},
    {"assert": {"node": "%SelectionRoster", "prop": "cells_shown", "equals": 0}},
    {"assert": {"node": "%SelectionRoster/Frame", "prop": "name", "equals": "Frame"}},
    {"shot": "f79_0_empty.png"},
    {"press": "check_tick"},
    {"wait": 0.3},
    {"assert": {"node": "%SelectionRoster", "prop": "count", "equals": 4}},
    {"assert": {"node": "%SelectionRoster", "prop": "mode", "equals": "unit"}},
    {"assert": {"node": "%SelectionRoster", "prop": "cells_shown", "equals": 4}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "prop": "tag", "equals": "ycro"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "prop": "health_fraction", "equals": 1.0}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1/Icon", "prop": "texture", "contains": "ImageTexture"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell2", "prop": "tag", "equals": "ycro"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell2", "prop": "health_fraction", "equals": 1.0}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell2/Icon", "prop": "texture", "contains": "ImageTexture"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell3", "prop": "tag", "equals": "ycro"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell3", "prop": "health_fraction", "equals": 1.0}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell3/Icon", "prop": "texture", "contains": "ImageTexture"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell4", "prop": "tag", "equals": "ycro"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell4", "prop": "health_fraction", "equals": 1.0}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell4/Icon", "prop": "texture", "contains": "ImageTexture"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell5", "visible": false}},
    {"assert": {"node": "%SelectionRoster", "prop": "last_build_us", "lte": 1500}},
    {"print": {"node": "%SelectionRoster", "prop": "last_build_us"}},
    {"print": {"node": "%SelectionRoster", "prop": "summary"}},
    {"shot": "f79_1_four.png"},
    {"drag": {"node": "%SelectionRoster/Scroll/Cells/Cell2", "from_x": 17, "from_y": 16, "to_x": 17, "to_y": 16}},
    {"wait": 0.2},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 1}},
    {"assert": {"node": "%SelectionRoster", "prop": "count", "equals": 1}},
    {"assert": {"node": "%SelectionRoster", "prop": "summary", "equals": "Trogg 960/960"}},
    {"assert": {"node": "%SelectionRoster", "prop": "cells_shown", "equals": 1}},
    {"press": "check_tick"},
    {"wait": 0.3},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 4}},
    {"drag": {"node": "%SelectionRoster/Scroll/Cells/Cell2", "from_x": 17, "from_y": 16, "to_x": 17, "to_y": 16, "ctrl": true}},
    {"wait": 0.2},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 4}},
    {"drag": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "from_x": 17, "from_y": 16, "to_x": 17, "to_y": 16, "shift": true}},
    {"wait": 0.2},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 3}},
    {"assert": {"node": "%SelectionRoster", "prop": "cells_shown", "equals": 3}},
    {"press": "check_tick"},
    {"wait": 0.3},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 4}},
    {"drag": {"node": "%SelectionRoster", "from_x": 96, "from_y": 236, "to_x": 96, "to_y": 236}},
    {"wait": 0.2},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 4}},
    {"assert": {"node": "%SelectionRoster", "prop": "count", "equals": 4}},
    {"drag": {"node": "%SelectionRoster", "from_x": 52, "from_y": 18, "to_x": 52, "to_y": 18}},
    {"wait": 0.2},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 4}}
  ]
}
