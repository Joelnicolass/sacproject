{
  "scene": "res://debug/selection_many.tscn",
  "wait_first": 2.5,
  "steps": [
    {"wait_until": {"node": "%OrdersLog", "text_contains": "Druid 800/800", "timeout": 40}},
    {"wait": 1.0},
    {"assert": {"node": "%SelectionRoster", "prop": "count", "equals": 0}},
    {"shot": "f79_many_0_empty.png"},
    {"press": "check_tick"},
    {"wait_until": {"node": "%SelectionRoster", "prop": "count", "equals": 150, "timeout": 10}},
    {"wait": 0.6},
    {"assert": {"node": "%SelectionRoster", "prop": "mode", "equals": "group"}},
    {"assert": {"node": "%SelectionRoster", "prop": "cells_shown", "equals": 3}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "prop": "tag", "equals": "oham"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell2", "prop": "tag", "equals": "palk"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell3", "prop": "tag", "equals": "ycro"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "prop": "count", "equals": 50}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell2", "prop": "count", "equals": 50}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell3", "prop": "count", "equals": 50}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1/Count", "text_equals": "50"}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell3/Count", "text_equals": "50"}},
    {"assert": {"node": "%SelectionRoster", "prop": "last_build_us", "lte": 1500}},
    {"assert": {"node": "%SelectionRoster", "prop": "last_refresh_us", "lte": 300}},
    {"print": {"node": "%SelectionRoster", "prop": "last_build_us"}},
    {"print": {"node": "%SelectionRoster", "prop": "last_refresh_us"}},
    {"assert": {"node": "%SelectionRoster/Ability", "visible": true}},
    {"assert": {"node": "%SelectionRoster", "prop": "ability_tag", "equals": "dihk"}},
    {"shot": "f79_2_grouped150.png"},
    {"drag": {"node": "%SelectionRoster/Scroll/Cells/Cell3", "from_x": 17, "from_y": 16, "to_x": 17, "to_y": 16}},
    {"wait": 0.4},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 50}},
    {"assert": {"node": "%SelectionRoster", "prop": "cells_shown", "equals": 1}},
    {"assert": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "prop": "tag", "equals": "ycro"}},
    {"press": "check_tick"},
    {"wait_until": {"node": "%SelectionRoster", "prop": "count", "equals": 150, "timeout": 10}},
    {"wait": 0.4},
    {"drag": {"node": "%SelectionRoster/Scroll/Cells/Cell1", "from_x": 17, "from_y": 16, "to_x": 17, "to_y": 16, "shift": true}},
    {"wait": 0.4},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 100}},
    {"assert": {"node": "%SelectionRoster", "prop": "cells_shown", "equals": 2}},
    {"shot": "f79_many_shift.png"},
    {"press": "check_tick"},
    {"wait_until": {"node": "%SelectionRoster", "prop": "count", "equals": 150, "timeout": 10}},
    {"wait": 0.4},
    {"drag": {"node": "%SelectionRoster", "from_x": 96, "from_y": 236, "to_x": 96, "to_y": 236}},
    {"wait": 0.3},
    {"assert": {"node": "%Selection", "prop": "count", "equals": 150}},
    {"print": {"node": "%SelectionRoster", "prop": "last_refresh_us"}}
  ]
}
