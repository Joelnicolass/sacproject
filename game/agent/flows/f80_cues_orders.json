{
 "scene": "res://debug/orders_group.tscn",
 "wait_first": 2.0,
 "steps": [
  {
   "wait_until": {
    "node": "%OrdersLog",
    "text_contains": "Druid 800/800",
    "timeout": 15
   }
  },
  {
   "call": {
    "harness": "cue_probe",
    "method": "mirror",
    "args": [
     true
    ]
   }
  },
  {
   "press": "check_tick"
  },
  {
   "wait": 0.4
  },
  {
   "press": {
    "name": "turn_left",
    "hold": 0.2
   }
  },
  {
   "wait": 0.5
  },
  {
   "call": {
    "harness": "selection_probe",
    "method": "aim_body",
    "args": [
     "Druid1",
     1.5
    ]
   }
  },
  {
   "wait": 0.3
  },
  {
   "assert": {
    "node": "%Selection",
    "prop": "count",
    "equals": 4
   }
  },
  {
   "assert": {
    "node": "%Battle",
    "text_equals": "4 unidades"
   }
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": ""
   }
  },
  {
   "press": "order_attack"
  },
  {
   "wait": 0.2
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": "attack"
   }
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed_icon",
    "equals": "Matt"
   }
  },
  {
   "assert": {
    "node": "%Battle",
    "text_equals": "Elegí el blanco"
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "visible": true
   }
  },
  {
   "assert": {
    "node": "%TargetProbe",
