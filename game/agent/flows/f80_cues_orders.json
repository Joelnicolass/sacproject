    "equals": "enemy_unit"
   }
  },
  {
   "assert": {
    "node": "%CursorSkin",
    "prop": "current",
    "equals": "Tnme"
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Invalid",
    "visible": false
   }
  },
  {
   "print": {
    "node": "%TargetProbe",
    "prop": "pointer"
   }
  },
  {
   "shot": "f80_2_attack_armed.png"
  },
  {
   "press": "order_units"
  },
  {
   "wait": 0.2
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": ""
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "visible": false
   }
  },
  {
   "press": "order_guard"
  },
  {
   "wait": 0.2
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": "guard"
   }
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed_icon",
    "equals": "Mgua"
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "visible": true
   }
  },
  {
   "shot": "f80_2b_guard_armed.png"
  },
  {
   "press": "order_units"
  },
  {
   "wait": 0.2
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": ""
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "visible": false
   }
  },
  {
   "press": {
    "name": "order_menu",
    "pressed": true
   }
  },
  {
   "wait": 0.6
  },
  {
   "assert": {
    "node": "%RadialMenu",
    "visible": true
   }
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": ""
   }
  },
  {
   "shot": "f80_5_menu.png"
  },
  {
   "press": {
    "name": "order_menu",
    "pressed": false
   }
  },
  {
   "wait": 0.3
  },
  {
   "assert": {
    "node": "%RadialMenu",
    "visible": false
   }
  },
  {
   "press": "order_units"
  },
  {
   "wait": 0.2
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": ""
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "visible": false
   }
  },
  {
   "assert": {
    "node": "%Selection",
    "prop": "count",
    "equals": 4
   }
  }
 ]
}
