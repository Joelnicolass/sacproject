{
  "scene": "res://debug/orders_group.tscn",
  "wait_first": 2.0,
  "steps": [
    {
      "wait_until": {
        "node": "%OrdersLog",
        "text_contains": "Druid 800/800",
        "timeout": 25
      }
    },
    {
      "assert": {
        "node": "%SpellBook",
        "visible": true
      }
    },
    {
      "assert": {
        "node": "%SelectionRoster",
        "visible": true
      }
    },
    {
      "press": "check_tick"
    },
    {
      "wait": 0.3
    },
    {
      "assert": {
        "node": "%SelectionRoster",
        "prop": "cells_shown",
        "equals": 4
      }
    },
    {
      "call": {
        "harness": "cue_probe",
        "method": "mirror",
        "args": [
          true
        ]
      }
    },
    {
      "press": "spell_1"
    },
    {
      "wait": 0.4
    },
    {
      "assert": {
        "node": "%CommandCue/Aim",
        "visible": true
      }
    },
    {
      "print": {
        "node": "%SpellBook",
        "prop": "scale"
      }
    },
    {
      "print": {
        "node": "%SelectionRoster",
        "prop": "scale"
      }
    },
    {
      "print": {
        "node": "%CommandCue/Aim",
        "prop": "size"
      }
    },
    {
      "print": {
        "node": "%CommandCue/Mirror",
        "prop": "size"
      }
    },
    {
      "print": {
        "node": "%CursorSkin",
        "prop": "_applied_px"
      }
    },
    {
      "shot": "f84_hud.png"
    },
    {
      "call": {
        "harness": "hud_scale_probe",
        "method": "report"
      }
    },
    {
      "assert": {
        "node": "AgentKit/hud_scale_probe",
        "prop": "same",
        "equals": true
      }
    },
    {
      "call": {
        "harness": "hud_scale_probe",
        "method": "set_hud",
        "args": [
          1.4
        ]
      }
    },
    {
      "wait": 0.3
    },
    {
      "call": {
        "harness": "hud_scale_probe",
        "method": "report"
      }
    },
    {
      "assert": {
        "node": "AgentKit/hud_scale_probe",
        "prop": "same",
        "equals": true
      }
    },
    {
      "shot": "f84_hud_live_1_4.png"
    },
    {
      "call": {
        "harness": "hud_scale_probe",
        "method": "set_hud",
        "args": [
          0.6
        ]
      }
    },
    {
      "wait": 0.3
    },
    {
      "call": {
        "harness": "hud_scale_probe",
        "method": "report"
      }
    },
    {
      "assert": {
        "node": "AgentKit/hud_scale_probe",
        "prop": "same",
        "equals": true
      }
    },
    {
      "shot": "f84_hud_live_0_6.png"
    }
  ]
}
