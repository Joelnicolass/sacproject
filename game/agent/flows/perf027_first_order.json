{
  "scene": "res://debug/orders/selection_many.tscn",
  "wait_first": 2.5,
  "steps": [
    {
      "wait_until": {
        "node": "%OrdersLog",
        "text_contains": "Druid 800/800",
        "timeout": 25
      }
    },
    {
      "assert": {
        "node": "%OrdersLog",
        "text_contains": "150 propias"
      }
    },
    {
      "wait": 1.0
    },
    {
      "press": "check_tick"
    },
    {
      "wait": 0.3
    },
    {
      "assert": {
        "node": "%Selection",
        "prop": "count",
        "equals": 150
      }
    },
    {
      "call": {
        "harness": "selection_probe",
        "method": "aim_empty"
      }
    },
    {
      "press": "order_units"
    },
    {
      "wait": 0.3
    },
    {
      "wait_until": {
        "node": "Group",
        "prop": "ordered_count",
        "equals": 150,
        "timeout": 5
      }
    },
    {
      "print": {
        "node": "%Orders",
        "prop": "last_apply_us"
      }
    },
    {
      "assert": {
        "node": "%Orders",
        "prop": "last_apply_us",
        "lte": 12000
      }
    },
    {
      "wait": 2.0
    },
    {
      "print": {
        "node": "Group",
        "prop": "frame_ms"
      }
    },
    {
      "shot": "perf027_first_order_moving.png"
    }
  ]
}
