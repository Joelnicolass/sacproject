{
  "scene": "res://debug/units/summon_unit.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 10 } },
    { "assert": { "node": "%Slots/Creature2/Cooldown", "visible": false } },
    { "press": "creature_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Trogg" } },
    { "wait": 0.6 },
    { "print": { "node": "%Slots/Creature2/Time", "prop": "text" } },
    { "print": { "node": "%Slots/Creature2/Cooldown", "prop": "value" } },
    { "assert": { "node": "%Slots/Creature2/Cooldown", "visible": true } },
    { "assert": { "node": "%Slots/Creature2/Cooldown", "prop": "value", "gte": 0.7 } },
    { "shot": "pt145_1_cooling.png" },
    { "wait": 1.5 },
    { "print": { "node": "%Slots/Creature2/Time", "prop": "text" } },
    { "print": { "node": "%Slots/Creature2/Cooldown", "prop": "value" } },
    { "assert": { "node": "%Slots/Creature2/Cooldown", "visible": true } },
    { "assert": { "node": "%Slots/Creature2/Cooldown", "prop": "value", "lte": 0.65 } },
    { "shot": "pt145_2_lower.png" },
    { "wait": 3.0 },
    { "print": { "node": "%Slots/Creature2/Cooldown", "prop": "value" } },
    { "assert": { "node": "%Slots/Creature2/Cooldown", "visible": false } },
    { "shot": "pt145_3_ready.png" }
  ]
}
