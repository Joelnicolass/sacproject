{
  "scene": "res://debug/spells/cast_heal.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 10 } },
    { "print": { "node": "%Title", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "/1500 · Maná 1000/1000 · Almas 12" } },
    { "click": "%SpellBook/Tabs/SpellTab" },
    { "wait": 0.1 },
    { "print": { "node": "%SpellBook/Slots/Spell1/Name", "prop": "text" } },
    { "print": { "node": "%SpellBook/Slots/Spell1", "prop": "tooltip_text" } },
    { "print": { "node": "%SpellBook/Slots/Spell2/Name", "prop": "text" } },
    { "print": { "node": "%SpellBook/Slots/Spell2", "prop": "tooltip_text" } },
    { "print": { "node": "%SpellBook/Slots/Spell3/Name", "prop": "text" } },
    { "print": { "node": "%SpellBook/Slots/Spell3", "prop": "tooltip_text" } },
    { "assert": { "node": "%SpellBook/Slots/Spell3/Name", "text_equals": "Heal" } },
    { "assert": { "node": "%SpellBook/Slots/Spell3/Time", "visible": false } },
    { "shot": "pt24_heal_0_start.png" },
    { "shot": { "name": "pt24_heal_0_bar.png", "node": "%SpellBook" } },
    { "press": "spell_3" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Heal" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait": 0.4 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt24_heal_1_particle.png" },
    { "shot": { "name": "pt24_heal_1_bar.png", "node": "%SpellBook" } },
    { "assert": { "node": "%SpellBook/Slots/Spell3/Cooldown", "visible": true } },
    { "print": { "node": "%SpellBook/Slots/Spell3/Time", "prop": "text" } },
    { "print": { "node": "%SpellBook/Slots/Spell2/Time", "prop": "text" } },
    { "wait": 0.5 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "assert": { "node": "%Battle", "text_equals": "cooling" } },
    { "print": { "node": "%SpellBook/Slots/Spell2/Time", "prop": "text" } },
    { "wait": 0.9 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait": 1.0 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%SpellBook/Slots/Spell2/Time", "prop": "visible" } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "wait": 0.9 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait": 1.0 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "wait": 0.5 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_equals": "Vida 1500/1500 · Maná 700/1000 · Almas 12" } },
    { "shot": "pt24_heal_2_full.png" },
    { "repeat": {
        "times": 40,
        "until": { "node": "%HitLog", "text_contains": "mira Druid" },
        "steps": [ { "press": { "name": "zoom_out", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "click": "%View" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "press": { "name": "zoom_in", "hold": 0.6 } },
    { "wait": 0.3 },
    { "press": "spell_1" },
    { "wait": 0.1 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "assert": { "node": "%Battle", "text_equals": "cooling" } },
    { "print": { "node": "%SpellBook/Slots/Spell1/Time", "prop": "text" } },
    { "wait": 2.4 },
    { "press": "spell_1" },
    { "wait": 0.1 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Speedup" } },
    { "wait": 1.0 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Maná 100/1000" } },
    { "wait": 2.6 },
    { "press": "spell_3" },
    { "wait": 0.1 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "assert": { "node": "%Battle", "text_equals": "no_mana" } },
    { "shot": "pt24_heal_3_no_mana.png" },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "print": { "node": "%Battle", "prop": "text" } }
  ]
}
