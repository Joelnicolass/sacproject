{
  "scene": "res://debug/cast_heal.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 10 } },
    { "wait": 0.5 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "press": { "name": "move_forward", "hold": 1.0 } },
    { "wait": 0.2 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "speed_factor" } },
    { "press": "spell_1" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Speedup" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "speed_factor" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "press": { "name": "move_forward", "hold": 1.0 } },
    { "wait": 0.2 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "speed_factor" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt24_speed_1_fast.png" },
    { "repeat": {
        "times": 60,
        "until": { "node": "%Wizards/Wizard1/SpeedupEffect", "visible_in_tree": false },
        "steps": [
          { "print": { "node": "%Wizards/Wizard1", "prop": "speed_factor" } },
          { "wait": 0.25 }
        ]
    } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "speed_factor" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "press": { "name": "move_forward", "hold": 1.0 } },
    { "wait": 0.2 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "global_position" } },
    { "shot": "pt24_speed_2_after.png" }
  ]
