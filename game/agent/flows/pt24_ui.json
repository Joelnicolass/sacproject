{
  "scene": "res://debug/cast_heal.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 10 } },
    { "print": { "node": "%Title", "prop": "text" } },
    { "print": { "node": "%SpellBook", "prop": "position" } },
    { "print": { "node": "%SpellBook", "prop": "size" } },
    { "print": { "node": "%Camera", "prop": "zoom" } },
    { "shot": "pt24_ui_0_default.png" },
    { "shot": { "name": "pt24_ui_0_bar.png", "node": "%SpellBook" } },
    { "press": { "name": "zoom_in", "hold": 0.8 } },
    { "wait": 0.3 },
    { "print": { "node": "%Camera", "prop": "zoom" } },
    { "shot": "pt24_ui_1_zoom_in.png" },
    { "press": { "name": "zoom_out", "hold": 2.5 } },
    { "wait": 0.3 },
    { "print": { "node": "%Camera", "prop": "zoom" } },
    { "shot": "pt24_ui_2_zoom_out.png" },
    { "press": { "name": "zoom_in", "hold": 1.7 } },
    { "wait": 0.3 },
    { "repeat": {
        "times": 60,
        "until": { "node": "%HitLog", "text_contains": "mira Druid" },
        "steps": [ { "press": { "name": "zoom_out", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "click": "%View" },
    { "print": { "node": "%Ping", "prop": "global_position" } },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "wait_until": { "node": "%Spells/Rock1", "timeout": 2 } },
    { "wait": 0.3 },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "shot": "pt24_ui_3_rock_up.png" },
    { "wait": 0.6 },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "shot": "pt24_ui_4_rock_mid.png" },
    { "wait_until": { "node": "%Spells/Rock1", "visible_in_tree": false, "timeout": 8 } },
    { "shot": "pt24_ui_5_rock_hit.png" },
    { "wait": 0.3 },
    { "shot": "pt24_ui_6_rock_dirt.png" }
  ]
}
