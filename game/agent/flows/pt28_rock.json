{
  "scene": "res://debug/units/rock_hit.tscn",
  "wait_first": 1.5,
  "steps": [
    { "wait_until": { "node": "%HitLog", "text_contains": "Druid 800/800", "timeout": 10 } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "click": "%SpellBook/Tabs/SpellTab" },
    { "wait": 0.1 },
    { "print": { "node": "%SpellBook/Slots/Spell2/Name", "prop": "text" } },
    { "shot": "pt28_0_start.png" },
    { "repeat": {
        "times": 40,
        "until": { "node": "%HitLog", "text_contains": "mira Druid" },
        "steps": [ { "press": { "name": "zoom_out", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "shot": "pt28_1_aim_druid.png" },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "wait": 0.25 },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "shot": "pt28_2_rising.png" },
    { "wait": 0.4 },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "shot": "pt28_3_rising2.png" },
    { "wait": 0.4 },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt28_4_flying.png" },
    { "wait": 0.4 },
    { "print": { "node": "%Spells/Rock1", "prop": "global_position" } },
    { "shot": "pt28_5_flying2.png" },
    { "wait_until": { "node": "%HitLog", "text_contains": "dano Druid 650 vida 150", "timeout": 6 } },
    { "shot": "pt28_6_impact.png" },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "assert": { "node": "%HitLog", "text_contains": "Druid 150/800" } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } },
    { "wait": 0.3 },
    { "shot": "pt28_7_after_hit.png" },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Enfriando" } },
    { "wait": 8.0 },
    { "repeat": {
        "times": 40,
        "until": { "node": "%HitLog", "text_contains": "mira Trogg" },
        "steps": [ { "press": { "name": "zoom_in", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt28_8_aim_trogg.png" },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Rock" } },
    { "wait_until": { "node": "%HitLog", "text_contains": "Trogg inmune", "timeout": 8 } },
    { "shot": "pt28_9_trogg_impact.png" },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } },
    { "wait": 9.6 },
    { "repeat": {
        "times": 60,
        "until": { "node": "%HitLog", "text_contains": "mira suelo" },
        "steps": [ { "press": { "name": "zoom_in", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Blanco inválido" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt28_10_ground_invalid.png" },
    { "wait": 1.0 },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } }
  ]
}
