{
  "scene": "res://scenes/ui/boot.tscn",
  "wait_first": 1.5,
  "steps": [
    { "click": "%God_persephone" },
    { "wait": 0.2 },
    { "print": { "node": "%Book", "prop": "text" } },
    { "click": "%Play" },
    { "wait": 0.2 },
    { "assert": { "node": "%Choice", "text_contains": "Persephone" } },
    { "print": { "node": "%Choice", "prop": "text" } },
    { "shot": "wrath_0_boot.png" },
    { "scene": "res://debug/rock_hit.tscn" },
    { "wait": 1.5 },
    { "wait_until": { "node": "%HitLog", "text_contains": "Druid 800/800", "timeout": 10 } },
    { "print": { "node": "%Title", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "click": "%SpellBook/Tabs/SpellTab" },
    { "wait": 0.1 },
    { "print": { "node": "%SpellBook/Slots/Spell1/Name", "prop": "text" } },
    { "print": { "node": "%SpellBook/Slots/Spell2/Name", "prop": "text" } },
    { "print": { "node": "%SpellBook/Slots/Spell3/Name", "prop": "text" } },
    { "assert": { "node": "%SpellBook/Slots/Spell2/Name", "text_equals": "Wrath" } },
    { "repeat": {
        "times": 40,
        "until": { "node": "%HitLog", "text_contains": "mira Druid" },
        "steps": [ { "press": { "name": "zoom_out", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "shot": "wrath_1_aim.png" },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Wrath" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "wrath_2_cast.png" },
    { "wait": 0.6 },
    { "print": { "node": "%Spells/Wrath1", "prop": "global_position" } },
    { "shot": "wrath_3_fly.png" },
    { "wait": 0.4 },
    { "print": { "node": "%Spells/Wrath1", "prop": "global_position" } },
    { "shot": "wrath_4_fly.png" },
    { "wait_until": { "node": "%HitLog", "text_contains": "dano Druid", "timeout": 8 } },
    { "shot": "wrath_5_hit.png" },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%HitLog", "text_contains": "dano Druid 550 vida 250" } },
    { "assert": { "node": "%HitLog", "text_contains": "Trogg 960/960" } },
    { "wait": 0.3 },
    { "shot": "wrath_6_after.png" }
  ]
}
