{
  "scene": "res://debug/wizards/wizard_ghost.tscn",
  "wait_first": 0.3,
  "steps": [
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "%Wizards/Wizard1/Tilt/Mesh", "prop": "transparency" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "print": { "node": "Druid", "prop": "position" } },
    { "assert": { "node": "%GhostState", "visible": false } },
    { "shot": "pt31_00_start.png" },
    { "repeat": {
        "times": 300,
        "until": { "node": "%GhostState", "visible": true },
        "steps": [
          { "print": { "node": "%Stats", "prop": "text" } },
          { "print": { "node": "Druid", "prop": "mode" } },
          { "wait": 0.1 }
        ]
    } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%GhostState", "text_equals": "Fantasma" } },
    { "repeat": {
        "times": 7,
        "steps": [
          { "print": { "node": "%Wizards/Wizard1/Tilt/Mesh", "prop": "transparency" } },
          { "wait": 0.1 }
        ]
    } },
    { "shot": "pt31_01_rising.png" },
    { "repeat": {
        "times": 12,
        "steps": [
          { "print": { "node": "%Wizards/Wizard1/Tilt/Mesh", "prop": "transparency" } },
          { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
          { "wait": 0.1 }
        ]
    } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Vida 0/1500 · Maná 0/1000" } },
    { "print": { "node": "Druid", "prop": "mode" } },
    { "print": { "node": "Druid", "prop": "swings" } },
    { "shot": "pt31_02_ghost.png" },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "press": "spell_3" },
    { "wait": 0.3 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "press": "spell_1" },
    { "wait": 0.3 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "press": "creature_1" },
    { "wait": 0.6 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%Units", "prop": "child_count" } },
    { "shot": "pt31_03_ghost_keys.png" },
    { "wait": 1.5 },
    { "print": { "node": "Druid", "prop": "mode" } },
    { "print": { "node": "Druid", "prop": "swings" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "press": { "name": "move_forward", "hold": 3.0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "shot": "pt31_04_ghost_walk.png" },
    { "press": { "name": "move_forward", "hold": 3.5 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "repeat": {
        "times": 80,
        "until": { "node": "%Stats", "text_contains": "Vida 1500/1500" },
        "steps": [
          { "print": { "node": "%Stats", "prop": "text" } },
          { "wait": 0.25 }
        ]
    } },
    { "shot": "pt31_05_fount.png" },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "repeat": {
        "times": 13,
        "steps": [
          { "print": { "node": "%Wizards/Wizard1/Tilt/Mesh", "prop": "transparency" } },
          { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
          { "wait": 0.1 }
        ]
    } },
    { "wait_until": { "node": "%GhostState", "visible": false, "timeout": 3 } },
    { "print": { "node": "%Wizards/Wizard1/Tilt/Mesh", "prop": "transparency" } },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt31_06_revived.png" },
    { "press": "spell_3" },
    { "wait": 0.2 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.5 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt31_07_cast.png" },
    { "wait": 1.5 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "press": { "name": "move_backward", "hold": 2.0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } }
  ]
}
