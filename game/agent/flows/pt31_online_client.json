{
  "scene": "res://scenes/ui/boot.tscn",
  "wait_first": 0.8,
  "steps": [
    { "click": "%Play" },
    { "click": "%Join" },
    { "wait_until": { "node": "%Stats", "text_contains": "Almas 12", "timeout": 15 } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "%Wizards/Wizard1/Mesh", "prop": "transparency" } },
    { "shot": "pt31_on_00_start.png" },
    { "repeat": {
        "times": 250,
        "until": { "node": "%GhostState", "visible": true },
        "steps": [
          { "print": { "node": "%Stats", "prop": "text" } },
          { "wait": 0.1 }
        ]
    } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%GhostState", "text_equals": "Fantasma" } },
    { "repeat": {
        "times": 20,
        "steps": [
          { "print": { "node": "%Wizards/Wizard1/Mesh", "prop": "transparency" } },
          { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
          { "wait": 0.1 }
        ]
    } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "assert": { "node": "%Stats", "text_contains": "Vida 0/1950 · Maná 0/1900" } },
    { "print": { "node": "Druid", "prop": "mode" } },
    { "shot": "pt31_on_01_ghost.png" },
    { "press": "spell_3" },
    { "wait": 0.4 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "press": "creature_1" },
    { "wait": 0.6 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "press": { "name": "move_forward", "hold": 3.0 } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "press": { "name": "move_forward", "hold": 3.5 } },
    { "wait": 0.3 },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "repeat": {
        "times": 105,
        "until": { "node": "%Stats", "text_contains": "Vida 1950/1950" },
        "steps": [
          { "print": { "node": "%Stats", "prop": "text" } },
          { "wait": 0.25 }
        ]
    } },
    { "shot": "pt31_on_02_fount.png" },
    { "repeat": {
        "times": 13,
        "steps": [
          { "print": { "node": "%Wizards/Wizard1/Mesh", "prop": "transparency" } },
          { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
          { "wait": 0.1 }
        ]
    } },
    { "wait_until": { "node": "%GhostState", "visible": false, "timeout": 3 } },
    { "print": { "node": "%Wizards/Wizard1/Mesh", "prop": "transparency" } },
    { "print": { "node": "%Wizards/Wizard1/GhostForm", "prop": "stage" } },
    { "print": { "node": "%Wizards/Wizard1", "prop": "position" } },
    { "print": { "node": "%Stats", "prop": "text" } },
    { "shot": "pt31_on_03_revived.png" },
    { "press": "spell_3" },
    { "wait": 0.3 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.8 },
    { "print": { "node": "%Battle", "prop": "text" } },
    { "print": { "node": "%Stats", "prop": "text" } }
  ]
}
