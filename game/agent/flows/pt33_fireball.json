{
  "scene": "res://debug/cast_pyro.tscn",
  "wait_first": 2.0,
  "steps": [
    { "wait_until": { "node": "%Stats", "text_contains": "Vida", "timeout": 10 } },
    { "repeat": {
        "times": 40,
        "until": { "node": "%HitLog", "text_contains": "mira Druid" },
        "steps": [ { "press": { "name": "zoom_out", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "click": "%SpellBook/Tabs/SpellTab" },
    { "wait": 0.1 },
    { "print": { "node": "%SpellBook/Slots/Spell2/Name", "prop": "text" } },
    { "assert": { "node": "%SpellBook/Slots/Spell2/Name", "text_equals": "Fireball" } },
    { "shot": "pt33_fireball_0_spellbook.png" },
    { "press": "spell_2" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Elegí el blanco" } },
    { "click": "%View" },
    { "wait": 0.1 },
    { "assert": { "node": "%Battle", "text_equals": "Fireball" } },
    { "wait_until": { "node": "%HitLog", "text_contains": "dano Druid", "timeout": 6 } },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "shot": "pt33_fireball_1_hit.png" }
  ]
}
