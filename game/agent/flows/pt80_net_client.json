   }
  },
  {
   "wait": 1.0
  },
  {
   "call": {
    "harness": "cue_probe",
    "method": "mirror",
    "args": [
     true
    ]
   }
  },
  {
   "press": "spell_2"
  },
  {
   "wait": 0.3
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": "spell"
   }
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed_icon",
    "equals": "kcor"
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
