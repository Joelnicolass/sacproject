    "visible": true
   }
  },
  {
   "call": {
    "harness": "cue_probe",
    "method": "report"
   }
  },
  {
   "shot": "pt80_net_attack_armed.png"
  },
  {
   "press": "order_units"
  },
  {
   "wait": 0.2
  },
  {
   "assert": {
    "node": "%Battle",
    "prop": "armed",
    "equals": ""
   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "visible": false
   }
  },
  {
   "shot": "pt80_net_rest_sel150.png"
  }
 ]
}