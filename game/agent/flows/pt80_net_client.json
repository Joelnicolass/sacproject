  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "visible": false
   }
  },
  {
   "press": "check_tick"
  },
  {
   "wait": 0.5
  },
  {
   "assert": {
    "node": "%Selection",
    "prop": "count",
    "equals": 150
   }
  },
  {
   "press": "order_attack"
