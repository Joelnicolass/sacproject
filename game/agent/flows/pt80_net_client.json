   }
  },
  {
   "assert": {
    "node": "%CommandCue/Aim",
    "prop": "texture",
    "contains": "ImageTexture"
   }
  },
  {
   "call": {
    "harness": "cue_probe",
    "method": "report"
   }
  },
  {
   "shot": "pt80_net_rock_armed.png"
  },
  {
   "press": "order_units"
  },
  {
   "wait": 0.2
  },
  {
   "assert": {
