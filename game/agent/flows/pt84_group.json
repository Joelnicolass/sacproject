{
 "scene": "res://debug/orders_group.tscn",
 "wait_first": 2.0,
 "steps": [
  { "wait_until": { "node": "%OrdersLog", "text_contains": "Druid 800/800", "timeout": 25 } },
  { "wait": 0.8 },
  { "assert": { "node": "%SpellBook", "visible": true } },
  { "shot": "g0_idle.png" },
  { "press": "check_tick" },
  { "wait": 0.5 },
  { "assert": { "node": "%SelectionRoster", "prop": "cells_shown", "equals": 4 } },
  { "print": { "node": "%SelectionRoster", "prop": "scale" } },
  { "print": { "node": "%SelectionRoster", "prop": "size" } },
  { "print": { "node": "%SelectionRoster", "prop": "global_position" } },
  { "print": { "node": "%SpellBook", "prop": "scale" } },
  { "print": { "node": "%SpellBook", "prop": "size" } },
  { "print": { "node": "%SpellBook", "prop": "global_position" } },
  { "shot": "g1_four.png" },
  { "call": { "harness": "cue_probe", "method": "mirror", "args": [true] } },
  { "call": { "harness": "selection_probe", "method": "aim_empty" } },
  { "press": "spell_2" },
  { "wait": 0.4 },
  { "assert": { "node": "%Battle", "prop": "armed", "equals": "spell" } },
  { "assert": { "node": "%Battle", "prop": "armed_icon", "equals": "kcor" } },
  { "assert": { "node": "%CommandCue/Aim", "visible": true } },
  { "print": { "node": "%CommandCue/Aim", "prop": "position" } },
  { "print": { "node": "%CommandCue/Aim", "prop": "size" } },
  { "print": { "node": "%CommandCue/Mirror", "prop": "position" } },
  { "print": { "node": "%CommandCue/Mirror", "prop": "size" } },
  { "call": { "harness": "hud_scale_probe", "method": "report" } },
  { "assert": { "node": "AgentKit/hud_scale_probe", "prop": "same", "equals": true } },
  { "shot": "g2_rock_armed.png" }
 ]
}
