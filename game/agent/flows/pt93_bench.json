{
  "scene": "res://debug/spells/wrath_splash_building.tscn",
  "wait_first": 1.5,
  "steps": [
    { "wait_until": { "node": "%HitLog", "text_contains": "jcc2_1 1000/1000", "timeout": 15 } },
    { "call": { "harness": "pt93_frame", "method": "watch_inspector" } },
    { "call": { "harness": "splash_probe", "method": "watch" } },
    { "print": { "node": "%Selection", "prop": "count" } },
    { "click": "%SpellBook/Tabs/SpellTab" },
    { "wait": 0.1 },
    { "assert": { "node": "%SpellBook/Slots/Spell2/Name", "text_equals": "Wrath" } },
    { "repeat": {
        "times": 40,
        "until": { "node": "%HitLog", "text_contains": "mira Druid" },
        "steps": [ { "press": { "name": "zoom_out", "hold": 0.03 } }, { "wait": 0.15 } ]
    } },
    { "print": { "node": "%HitLog", "prop": "text" } },

    { "call": { "harness": "selection_probe", "method": "aim_body", "args": ["jcc2_1", 1.0] } },
    { "press": "select" },
    { "wait": 0.3 },
    { "print": { "node": "%Inspector", "prop": "inspected_name" } },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "jcc2_1" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 1 } },
    { "assert": { "node": "%Inspector", "prop": "inspected_fraction", "equals": 1.0 } },
    { "shot": "pt93_b1_cactus_lleno.png" },
    { "call": { "harness": "pt93_frame", "method": "frame", "args": ["jcc2_1", 14, 5, 200, 1.0] } },
    { "wait": 0.6 },
    { "shot": "pt93_b1b_cactus_lleno_14m.png" },
    { "call": { "harness": "pt93_frame", "method": "stop" } },
    { "wait": 0.6 },
    { "wait_until": { "node": "%HitLog", "text_contains": "mira Druid", "timeout": 3 } },

    { "press": "spell_2" },
    { "wait": 0.1 },
    { "click": "%View" },
    { "wait_until": { "node": "%HitLog", "text_contains": "dano jcc2_1", "timeout": 8 } },
    { "wait": 0.3 },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "call": { "harness": "splash_probe", "method": "check", "args": ["jcc2_1", 550, 5] } },
    { "print": { "node": "%Inspector", "prop": "inspected_fraction" } },
    { "assert": { "node": "%HitLog", "text_contains": "dano Druid 550" } },
    { "assert": { "node": "%HitLog", "text_contains": "dano jcc2_1 293" } },
    { "assert": { "node": "%HitLog", "text_contains": "jfn1_2 0/0" } },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "jcc2_1" } },
    { "shot": "pt93_b2_cactus_293.png" },
    { "call": { "harness": "pt93_frame", "method": "frame", "args": ["jcc2_1", 14, 5, 200, 1.0] } },
    { "wait": 0.6 },
    { "shot": "pt93_b2b_cactus_293_14m.png" },
    { "call": { "harness": "pt93_frame", "method": "stop" } },
    { "wait": 0.6 },
    { "wait_until": { "node": "%HitLog", "text_contains": "mira Druid", "timeout": 3 } },

    { "repeat": {
        "times": 20,
        "until": { "node": "%HitLog", "text_contains": "Druid 0/" },
        "steps": [ { "press": "spell_2" }, { "wait": 0.1 }, { "click": "%View" }, { "wait": 1.5 } ]
    } },
    { "wait": 1.0 },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "print": { "node": "%Inspector", "prop": "inspected_fraction" } },
    { "shot": "pt93_b3_druid_muerto.png" },

    { "call": { "harness": "selection_probe", "method": "aim_body", "args": ["jfn1_2", 1.0] } },
    { "press": "select" },
    { "wait": 0.3 },
    { "print": { "node": "%Inspector", "prop": "inspected" } },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 0 } },

    { "call": { "harness": "pt93_frame", "method": "line_up", "args": ["corpse", "jcc2_1", 2.2, 0.0, 0.35] } },
    { "wait": 0.8 },
    { "call": { "harness": "pt93_frame", "method": "aim", "args": ["corpse", 0.35] } },
    { "shot": "pt93_b4_cadaver_delante_antes.png" },
    { "press": "select" },
    { "wait": 0.3 },
    { "print": { "node": "%Inspector", "prop": "inspected" } },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 0 } },
    { "shot": "pt93_b5_cadaver_delante_despues.png" },

    { "call": { "harness": "pt93_frame", "method": "frame", "args": ["jcc2_1", 14, 5, 200, 1.0] } },
    { "wait": 0.8 },
    { "call": { "harness": "selection_probe", "method": "aim_body", "args": ["jcc2_1", 1.0] } },
    { "press": "select" },
    { "wait": 0.3 },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "jcc2_1" } },
    { "print": { "node": "%Inspector", "prop": "inspected_fraction" } },
    { "shot": "pt93_b6_cactus_reinspeccionado.png" },
    { "repeat": {
        "times": 12,
        "until": { "node": "%Inspector", "prop": "inspected_name", "equals": "" },
        "steps": [ { "press": "spell_2" }, { "wait": 0.1 }, { "press": "select" }, { "wait": 2.0 } ]
    } },
    { "wait": 0.5 },
    { "print": { "node": "%HitLog", "prop": "text" } },
    { "call": { "harness": "pt93_frame", "method": "events" } },
    { "print": { "node": "%Inspector", "prop": "inspected" } },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 0 } },
    { "shot": "pt93_b7_cactus_caido.png" },
    { "wait": 1.0 }
  ]
}
