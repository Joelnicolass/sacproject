{
  "scene": "res://debug/village.tscn",
  "wait_first": 1.0,
  "steps": [
    { "wait_until": { "node": "HighNoon/Units/Hunter", "timeout": 30 } },
    { "wait": 1.0 },
    { "call": { "harness": "pt93_frame", "method": "watch_inspector" } },
    { "assert": { "node": "%Selection", "prop": "count", "equals": 1 } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 0 } },

    { "call": { "harness": "pt73_watch", "method": "view", "args": ["point:1255,1214", 20, 8, 20] } },
    { "wait": 0.6 },
    { "call": { "harness": "pt73w_house", "method": "aim_house", "args": [1255, 1214, "jhut"] } },
    { "press": "select" },
    { "wait": 0.3 },
    { "print": { "node": "%Inspector", "prop": "inspected_name" } },
    { "assert": { "node": "%Inspector", "prop": "inspected.tag", "equals": "jhut" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 1 } },
    { "assert": { "node": "%Selection", "prop": "count", "equals": 1 } },
    { "shot": "pt93_v1_casa_20m.png" },
    { "call": { "harness": "pt73_watch", "method": "view", "args": ["point:1255,1214", 40, 16, 20] } },
    { "wait": 0.6 },
    { "shot": "pt93_v2_casa_40m.png" },

    { "call": { "harness": "pt73_watch", "method": "view", "args": ["point:1246,1177", 16, 6, 20] } },
    { "wait": 0.6 },
    { "call": { "harness": "pt73w_house", "method": "aim_house", "args": [1246, 1177, "jcc2"] } },
    { "press": "select" },
    { "wait": 0.3 },
    { "print": { "node": "%Inspector", "prop": "inspected_name" } },
    { "assert": { "node": "%Inspector", "prop": "inspected.tag", "equals": "jcc2" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 1 } },
    { "assert": { "node": "%Selection", "prop": "count", "equals": 1 } },
    { "shot": "pt93_v3_cactus_16m.png" },
    { "call": { "harness": "pt73_watch", "method": "view", "args": ["point:1246,1177", 20, 8, 20] } },
    { "wait": 0.6 },
    { "shot": "pt93_v4_cactus_20m.png" },
    { "call": { "harness": "pt73_watch", "method": "view", "args": ["point:1246,1177", 40, 16, 20] } },
    { "wait": 0.6 },
    { "shot": "pt93_v5_cactus_40m.png" },

    { "call": { "harness": "pt73_watch", "method": "view", "args": ["", 1, 1, 0] } },
    { "call": { "harness": "pt93_frame", "method": "frame", "args": ["altar", 28, 10, 30, 2.0] } },
    { "wait": 0.8 },
    { "call": { "harness": "pt93_frame", "method": "aim", "args": ["altar", 2.0] } },
    { "press": "select" },
    { "wait": 0.3 },
    { "print": { "node": "%Inspector", "prop": "inspected" } },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 0 } },
    { "assert": { "node": "%Selection", "prop": "count", "equals": 1 } },
    { "shot": "pt93_v6_altar.png" },

    { "call": { "harness": "pt93_frame", "method": "line_up", "args": ["wizard", "near:jhut", 7, 0.8, 1.2] } },
    { "wait": 0.8 },
    { "call": { "harness": "pt93_frame", "method": "aim", "args": ["wizard", 1.2] } },
    { "shot": "pt93_v7_mago_delante_antes.png" },
    { "press": "select" },
    { "wait": 0.3 },
    { "print": { "node": "%Inspector", "prop": "inspected" } },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 0 } },
    { "assert": { "node": "%Selection", "prop": "count", "equals": 1 } },
    { "shot": "pt93_v8_mago_delante_despues.png" },

    { "call": { "harness": "pt93_frame", "method": "stop" } },
    { "call": { "harness": "pt73_watch", "method": "view", "args": ["point:1255,1214", 40, 16, 20] } },
    { "wait": 0.6 },
    { "call": { "harness": "pt73w_house", "method": "aim_house", "args": [1255, 1214, "jhut"] } },
    { "press": "select" },
    { "wait": 0.3 },
    { "assert": { "node": "%Inspector", "prop": "inspected.tag", "equals": "jhut" } },
    { "call": { "harness": "selection_probe", "method": "aim_empty" } },
    { "press": "select" },
    { "wait": 0.3 },
    { "assert": { "node": "%Inspector", "prop": "inspected_name", "equals": "" } },
    { "assert": { "node": "%Inspector", "prop": "visible_bar_count", "equals": 0 } },
    { "assert": { "node": "%Selection", "prop": "count", "equals": 0 } },
    { "shot": "pt93_v9_suelo.png" },
    { "call": { "harness": "pt93_frame", "method": "events" } }
  ]
}
