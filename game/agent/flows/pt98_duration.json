{
 "scene": "res://debug/spells/cast_stratos.tscn",
 "wait_first": 2.0,
 "steps": [
  {
   "wait_until": {
    "node": "%Stats",
    "text_contains": "Vida",
    "timeout": 10
   }
  },
  {
   "repeat": {
    "times": 40,
    "until": {
     "node": "%HitLog",
     "text_contains": "mira Druid"
    },
    "steps": [
     {
      "press": {
       "name": "zoom_out",
       "hold": 0.03
      }
     },
     {
      "wait": 0.15
     }
    ]
   }
  },
  {
   "click": "%SpellBook/Tabs/SpellTab"
  },
  {
   "wait": 0.1
  },
  {
   "assert": {
    "node": "%SpellBook/Slots/Spell2/Name",
    "text_equals": "Lightning"
   }
  },
  {
   "call": {
    "harness": "beam_watch",
    "method": "start",
    "args": [
     "lightning"
    ]
   }
  },
  {
   "press": "spell_2"
  },
  {
   "wait": 0.1
  },
  {
   "assert": {
    "node": "%Battle",
    "text_equals": "Eleg\u00ed el blanco"
   }
  },
  {
   "click": "%View"
  },
  {
   "wait_until": {
    "node": "%HitLog",
    "text_contains": "dano Druid",
    "timeout": 6
   }
  },
  {
   "wait_until": {
    "node": "AgentKit/beam_watch",
    "prop": "beams_done",
    "gte": 1,
    "timeout": 4
   }
  },
  {
   "print": {
    "node": "%HitLog",
    "prop": "text"
   }
  },
  {
   "call": {
    "harness": "beam_watch",
    "method": "report"
   }
  },
  {
   "assert": {
    "node": "AgentKit/beam_watch",
    "prop": "last_seconds",
    "gte": 1.0,
    "lte": 1.15
   }
  },
  {
   "assert": {
    "node": "AgentKit/beam_watch",
    "prop": "last_changes",
    "gte": 9
   }
  },
  {
   "assert": {
    "node": "AgentKit/beam_watch",
    "prop": "last_end_error_m",
    "lte": 0.5
   }
  }
 ]
}