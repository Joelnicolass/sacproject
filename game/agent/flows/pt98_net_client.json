{
 "scene": "res://scenes/ui/boot.tscn",
 "wait_first": 1.0,
 "steps": [
  {
   "click": "%Play"
  },
  {
   "click": "%Join"
  },
  {
   "wait_until": {
    "node": "%Stats",
    "text_contains": "Vida",
    "timeout": 40
   }
  },
  {
   "call": {
    "harness": "beam_watch",
    "method": "start",
    "args": [
     "lightning"
    ]
   }
  },
  {
   "wait_until": {
    "node": "%Wizards/Wizard2",
    "timeout": 40
   }
  },
  {
   "wait_until": {
    "node": "AgentKit/beam_watch",
    "prop": "beams_done",
    "gte": 1,
    "timeout": 200
   }
  },
  {
   "call": {
    "harness": "beam_watch",
    "method": "report"
   }
  },
  {
   "assert": {
    "node": "AgentKit/beam_watch",
    "prop": "last_seconds",
    "gte": 1.0,
    "lte": 1.15
   }
  },
  {
   "wait": 3.0
  },
  {
   "call": {
    "harness": "beam_watch",
    "method": "report"
   }
  }
 ]
}