world_scene = ExtResource("2_world")
erupt_zone = ExtResource("3_erupt")
volcano_zone = ExtResource("4_volcano")
camera = NodePath("Camera")

[node name="Camera" type="Camera3D" parent="."]
fov = 60.0
far = 20000.0
