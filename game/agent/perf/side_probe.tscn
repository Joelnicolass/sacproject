[gd_scene format=3]

[ext_resource type="Script" path="res://agent/perf/side_probe.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/world/high_noon.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/world/units/unit.tscn" id="3"]

[node name="SideProbe" type="Node" node_paths=PackedStringArray("world", "units", "view_camera")]
script = ExtResource("1")
world = NodePath("HighNoon")
units = NodePath("Units")
view_camera = NodePath("ViewCamera")
unit_scene = ExtResource("3")

[node name="HighNoon" parent="." instance=ExtResource("2")]

[node name="ViewCamera" type="Camera3D" parent="."]
current = true
fov = 60.0
far = 20000.0

[node name="Units" type="Node3D" parent="."]

[node name="Population" parent="HighNoon"]
spawn_creatures = false
