[gd_resource type="Resource" script_class="AiProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ai/data/ai_profile.gd" id="1_profile"]

; Los numeros de la IA original, version comercial (Sacrifice.exe): todos los `beta*` de
; sacengine/source/bots/shiny.d en falso (shiny.d:381-412). Cada linea cita `shiny.d:linea`.
; Marca de la fuente: «segun [S]» = lo que escribio el autor de sacengine leyendo el ejecutable (sus comentarios citan la
; direccion retail, p. ej. 0x4901a0); «verificado [O]» seria una comprobacion propia contra Sacrifice.exe con REA y en 024c no
; se hizo ninguna: ningun numero la lleva. Normal = estos numeros. Los .tres no se mutan jugando.

[resource]
script = ExtResource("1_profile")
; slot_periods: k0 updateStatus, k1 updateStance, k2 updateNtts, k3 updateGroups, k4 updateReplan, k5 updateTasks (shiny.d:468) segun [S]
slot_periods = PackedInt32Array(12, 60, 6, 6, 60, 12)
; aggression: fija en 1.0, nada la cambia (shiny.d:380, 662); el original no tiene dificultad. Segun [S]
aggression = 1.0
; en segundos a ritmo Normal (la IA los cuenta en edades de 6 ticks): rating 1,6 s = 16 edades (1044), estado 0,8 s = 8 (1053, 1095), almas del mago 3,2 s = 32 (1080). Segun [S]
rerate_s = 1.6
status_s = 0.8
souls_snapshot_s = 3.2
; amenaza del mago: cada 0,8 s (8 edades), influencia de grupos entre 10 y 280 m (shiny.d:1065-1072). Segun [S]
threat_s = 0.8
threat_near = 10.0
threat_far = 280.0
; canAccept: radio 30*min(1+0.1n, 1.8) (shiny.d:1702-1710). Segun [S]
group_radius_m = 30.0
group_growth = 0.1
group_cap = 1.8
; recordUpdate: 10000 = 100 m al cuadrado (shiny.d:3433). Segun [S]
record_near_m = 100.0
; desvio del port: 0 en el original (shiny.d:3419); 8 m para que los seguidores no empujen al mago fuera de su altar
follow_radius_m = 8.0
; guardia: se detiene a 10 m del blanco (retreatDistance, state.d:13608); sin esto el `guard` del port las apila a 2-3 m del mago
retreat_hold_m = 10.0
; replan del mago cada 1,6 s (16 edades) y reemision de orden cada 0,8 s (8) (shiny.d:3328, 3356). Segun [S]
wizard_replan_s = 1.6
wizard_reissue_s = 0.8
; wizAttack: alcance (1-amenaza)*280, retail 0x4901a0 (shiny.d:3058; la beta usa 180). Segun [S]
attack_coefficient = 280.0
; pesos del blanco (shiny.d:3070-3072): no agresivo x0.5, sin habilidad lista x1/3, Sac Doctor x10. Segun [S]
weight_passive = 0.5
weight_no_ability = 0.3333333432674408
weight_sac_doctor = 10.0
; findBestSpell: distSq*0.7142857 contra range^2; bajo 1600 cuenta 0 (shiny.d:2928-2934). Segun [S]
range_distance_scale = 0.7142857313156128
near_distance_sq = 1600.0
; wizSacrifice (shiny.d:3115-3172): Manahoar de emergencia si rand >= amenaza*1.3 (3124); criaturas solo con amenaza < 0.6 (3139);
; Manahoar forzado si ready < almas/2 (retail; la beta /4) y (ninguno listo o deficit por Manalith y listo > 1400) (3127-3131). Segun [S]
emergency_threat_factor = 1.2999999523162842
summon_threat_cap = 0.6
emergency_mana_ratio = 1400.0
ready_divisor = 2
; Captura y almas (024d). Segun [S]
; castCachedInRange: el mago construye un Manalith solo con amenaza < 0.9 (retail 0x490850; la beta 0.6) (shiny.d:3295)
build_threat_cap = 0.9
; almas que el mago toma tocandolas: (1-amenaza)*100+80 m (retail 0x490b20; la beta 80 y 60) (shiny.d:3330-3337)
soul_reach_scale = 100.0
soul_reach_base = 80.0
soul_keep_factor = 1.25
; wizRetreat: Convert se busca a (1-parte propia de almas)*(1-amenaza)*agresividad*500 m (shiny.d:3098)
convert_reach_m = 500.0
convert_score_factor = 0.8999999761581421
desecrate_range_factor = 0.8999999761581421
; autoCapture: un cuerpo sin mana busca fuente o Manahoar a 3620 m (shiny.d:2552)
mana_seek_m = 3620.0
; orderInteract de CAPTURE: radio (1-valor)*160 m (shiny.d:2565)
interact_reach_m = 160.0
