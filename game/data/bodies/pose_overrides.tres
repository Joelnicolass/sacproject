[sub_resource type="Resource" id="Resource_pcfn"]
script = ExtResource("2_entry")
model = "pcfn"
rotation_degrees = Vector3(0, 90, 0)
note = "Manantial: giro a mano que antes vivía en cache/baked/props.json."

[sub_resource type="Resource" id="Resource_sbob"]
script = ExtResource("2_entry")
model = "sbob"
position_offset = Vector3(0, -1.4, 0)
capsule_height = 1.65
note = "Brainiac (vuela): el clip idle ya trae el cuerpo 1,4 m sobre el origen (desplazamiento del SXSK, 2,136 m). Se baja para que quede a flying_height sin extra; la cápsula mide el cuerpo, no el hueco de abajo."

[sub_resource type="Resource" id="Resource_sacd"]
script = ExtResource("2_entry")
model = "sacd"
capsule_radius = 0.5
note = "Sac Doctor: el cuadro 0 del idle SDda (de pie, pies en y = 0) mide 2,62 x 2,75 x 3,28 m porque la jeringa va extendida; el radio horneado (0,35 x el lado menor = 0,92 m) sale de ahí. El cuerpo mide unos 1 m de ancho: la cápsula usa 0,5 m. El alcance horneado (1,64 m) se deja."

[sub_resource type="Resource" id="Resource_aprc"]
script = ExtResource("2_entry")
model = "aprc"
position_offset = Vector3(0, 0.40, 0)
capsule_height = 6.71
note = "Yeti (F112): el cuadro 0 de stance1 PCst deja la malla 0,40 m bajo el origen aunque el desplazamiento de raíz del SXSK ya sube la cadera; idle0 da lo mismo. Se sube 0,40 m (medido con tools/audit_body_pose.gd) y la cápsula mide el cuerpo entero. Causa probable: la malla respecto del desplazamiento de raíz, a revisar en RFC-023."

