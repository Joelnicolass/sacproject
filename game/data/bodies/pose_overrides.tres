[ext_resource type="Script" uid="uid://b40ejvc8kw2hn" path="res://scenes/data/body_pose_overrides.gd" id="1_list"]
[ext_resource type="Script" uid="uid://dfb27edjlkgjl" path="res://scenes/data/body_pose_override.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_pcfn"]
script = ExtResource("2_entry")
model = "pcfn"
rotation_degrees = Vector3(0, 90, 0)
note = "Manantial: giro a mano que antes vivía en cache/baked/props.json."

[sub_resource type="Resource" id="Resource_sbob"]
script = ExtResource("2_entry")
model = "sbob"
position_offset = Vector3(0, -1.4, 0)
capsule_height = 1.65
note = "Brainiac (vuela): el clip idle ya trae el cuerpo 1,4 m sobre el origen (desplazamiento del SXSK, 2,136 m). Se baja para que quede a flying_height sin extra; la cápsula mide el cuerpo, no el hueco de abajo."

[sub_resource type="Resource" id="Resource_sacd"]
script = ExtResource("2_entry")
model = "sacd"
capsule_radius = 0.5
note = "Sac Doctor: el cuadro 0 del idle SDda (de pie, pies en y = 0) mide 2,62 x 2,75 x 3,28 m porque la jeringa va extendida; el radio horneado (0,35 x el lado menor = 0,92 m) sale de ahí. El cuerpo mide unos 1 m de ancho: la cápsula usa 0,5 m. El alcance horneado (1,64 m) se deja."

[sub_resource type="Resource" id="Resource_aprc"]
script = ExtResource("2_entry")
model = "aprc"
position_offset = Vector3(0, 0.40, 0)
capsule_height = 6.71
note = "Yeti (F112): el cuadro 0 de stance1 PCst deja la malla 0,40 m bajo el origen aunque el desplazamiento de raíz del SXSK ya sube la cadera; idle0 da lo mismo. Se sube 0,40 m (medido con tools/audit_body_pose.gd) y la cápsula mide el cuerpo entero. Causa probable: la malla respecto del desplazamiento de raíz, a revisar en RFC-023."

[sub_resource type="Resource" id="Resource_prcy"]
script = ExtResource("2_entry")
model = "prcy"
position_offset = Vector3(0, 1.04, 0)
capsule_height = 6.25
note = "Netherfiend (F112): el cuadro 0 de stance1 PCst deja la malla 1,04 m bajo el origen aunque el desplazamiento de raíz del SXSK ya sube la cadera; idle0 da lo mismo. Se sube 1,04 m (medido con tools/audit_body_pose.gd) y la cápsula mide el cuerpo entero. Causa probable: la malla respecto del desplazamiento de raíz, a revisar en RFC-023."

[sub_resource type="Resource" id="Resource_ddmn"]
script = ExtResource("2_entry")
model = "ddmn"
position_offset = Vector3(0, 1.68, 0)
capsule_height = 11.02
note = "Hellmouth (F112): el cuadro 0 de stance1 DMst deja la malla 1,68 m bajo el origen aunque el desplazamiento de raíz del SXSK ya sube la cadera; idle0 da lo mismo. Se sube 1,68 m (medido con tools/audit_body_pose.gd) y la cápsula mide el cuerpo entero. Causa probable: la malla respecto del desplazamiento de raíz, a revisar en RFC-023. F134: desde que el reposo juega DMst (stance1) entero, la sección HIBRIDA de la auditoría mide el mínimo de todos los cuadros con este alzado: −0,18 m, dentro de C1. El alzado queda como desvío visual declarado hasta 030e2-R (REA). F135: cápsula 11,02 = p95 del tope de DMst (C2); en vuelo DMfl da p95 11,08, dentro de C3 con la de tierra, así que no lleva capsule_height_flying."

[sub_resource type="Resource" id="Resource_edmn"]
script = ExtResource("2_entry")
model = "edmn"
position_offset = Vector3(0, 1.40, 0)
capsule_height = 10.07
note = "Rhinok (F112): el cuadro 0 de stance1 Eds1 deja la malla 1,40 m bajo el origen aunque el desplazamiento de raíz del SXSK ya sube la cadera; idle0 da lo mismo. Se sube 1,40 m (medido con tools/audit_body_pose.gd) y la cápsula mide el cuerpo entero. Causa probable: la malla respecto del desplazamiento de raíz, a revisar en RFC-023. F134: el reposo ahora juega Eds1 (stance1) entero en vez del gesto Edi1, que era lo que se veía flotar; con este alzado el mínimo de todos los cuadros es −0,30 m, dentro de C1. El alzado queda como desvío visual declarado hasta 030e2-R (REA). F135: cápsula 10,07 = p95 del tope de Eds1 (C2). No tiene clip fly: no hay cápsula de vuelo."

[sub_resource type="Resource" id="Resource_fdrg"]
script = ExtResource("2_entry")
model = "fdrg"
rest_hovers = true
capsule_height = 15.21
note = "Phoenix (F134): el reposo DFst (stance1) flota a propósito. Solo toca el suelo en el fondo del aleteo (−0,03 m) y en la mediana de los cuadros queda unos 2,35 m arriba. La auditoría juzga el mínimo del clip, no la mediana. Sin desplazamiento: el origen sigue en el suelo, como en sacengine. F135: cápsula 15,21 = p95 del tope de DFst (C2). Se usa el tope y no la altura de la masa (unos 9,7 m en el cuadro 0) porque la cápsula nace en el origen, en el suelo, y el cuerpo flota encima: con la masa, los 3 a 5 m de arriba quedarían afuera. En vuelo DFfl da p95 13,79, dentro de C3 con la de tierra: sin capsule_height_flying."

[sub_resource type="Resource" id="Resource_adrg"]
script = ExtResource("2_entry")
model = "adrg"
capsule_height = 12.18
capsule_height_flying = 17.78
note = "Silverback (F135): cápsula 12,18 = p95 del tope de ADst (C2). En vuelo ADfl abre las alas y el cuello: p95 del tope 17,78 (C3, tools/audit_body_pose.gd); Flight cambia la altura al entrar y salir de FLYING."

[sub_resource type="Resource" id="Resource_dcak"]
script = ExtResource("2_entry")
model = "dcak"
capsule_height_flying = 7.19
note = "Blight (F135): en vuelo CKfl sube las alas: p95 del tope 7,19 (C3, tools/audit_body_pose.gd). La de tierra queda la horneada."

[sub_resource type="Resource" id="Resource_drag"]
