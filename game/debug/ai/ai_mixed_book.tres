[gd_resource type="Resource" script_class="GodBook" load_steps=15 format=3]

[ext_resource type="Script" path="res://scenes/gods/god_book.gd" id="1_book"]
[ext_resource type="Script" path="res://scenes/spells/spell_type.gd" id="2_spell"]
[ext_resource type="Resource" path="res://data/catalog/spells/olah.tres" id="s_olah"]
[ext_resource type="Resource" path="res://data/catalog/spells/mrhc.tres" id="s_mrhc"]
[ext_resource type="Resource" path="res://data/catalog/spells/taed.tres" id="s_taed"]
[ext_resource type="Resource" path="res://data/catalog/spells/rter.tres" id="s_rter"]
[ext_resource type="Resource" path="res://data/catalog/spells/wobr.tres" id="s_wobr"]
[ext_resource type="Resource" path="res://data/catalog/spells/ruah.tres" id="s_ruah"]
[ext_resource type="Resource" path="res://data/catalog/spells/deda.tres" id="s_deda"]
[ext_resource type="Resource" path="res://data/catalog/spells/dnws.tres" id="s_dnws"]
[ext_resource type="Resource" path="res://data/catalog/spells/pmcd.tres" id="s_pmcd"]
[ext_resource type="Resource" path="res://data/catalog/spells/elet.tres" id="s_elet"]
[ext_resource type="Resource" path="res://data/catalog/spells/ndrg.tres" id="s_ndrg"]
[ext_resource type="Resource" path="res://data/catalog/spells/pcas.tres" id="s_pcas"]

; 055f f5: el libro del laboratorio de hechizos de la IA (ai_spells_lab). Los hechizos que la IA no usaba antes de f5, todos desde el
; nivel 0, mas la torre Shrine. Sin criaturas: el mago solo lanza.

[resource]
script = ExtResource("1_book")
spells = Array[ExtResource("2_spell")]([ExtResource("s_olah"), ExtResource("s_mrhc"), ExtResource("s_taed"), ExtResource("s_rter"), ExtResource("s_wobr"), ExtResource("s_ruah"), ExtResource("s_deda"), ExtResource("s_dnws"), ExtResource("s_pmcd")])
structures = Array[ExtResource("2_spell")]([ExtResource("s_elet"), ExtResource("s_ndrg"), ExtResource("s_pcas")])
