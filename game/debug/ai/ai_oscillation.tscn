[node name="AiOscillation" instance=ExtResource("1_match")]
editor_description = "Ida y vuelta en el mismo lugar: ai_match con la sonda OscillationProbe (hijo de Judge). Cada segundo mide, por mago y criatura, camino y desplazamiento neto en 10 s y las vueltas del movimiento; --osc-trace=<slot> imprime una linea OSC por segundo con la orden, la tarea y la amenaza que la IA ve. Con reglas con filas probe (osc_s, osc_flips) da EXPECT PASS|FAIL."

[node name="Runner" parent="." index="3"]
default_rules = ExtResource("2_rules")

[node name="OscillationProbe" type="Node" parent="Judge" index="0"]
script = ExtResource("3_probe")
