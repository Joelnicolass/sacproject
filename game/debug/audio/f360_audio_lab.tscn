[node name="AudioLab" type="Node3D" node_paths=PackedStringArray("label", "selection", "orders", "command_log", "command_voice", "advisor", "advisor_watch")]
editor_description = "RFC-052 (F360+). Laboratorio de audio: dos criaturas (una con set del original, nmuh; una propia, testmonster), un mago y el oyente en una cámara fija. Los cuerpos están quietos; el lab mueve su estado replicado y los hijos *Sounds suenan. F6 y la acción debug_audio_event (J) recorre los pasos del lab_<corte>.tres. Desde 052d también un manantial (Fountain) y un altar (Altar) con sus bucles, y los pasos de FX (FxBus), proyectiles y bucles del lab_052d.tres. Desde 052e, las voces del jugador: Selection, Orders y CommandLog de laboratorio, CommandVoice, AdvisorVoice con su AdvisorWatch y un edificio propio (Building); pasos del lab_052e.tres. Sin ventana: --headless -- --audio-probe --audio-script[=res://debug/audio/lab_052c.tres] [--audio-no-original]."
script = ExtResource("1_lab")
label = NodePath("Overlay/LastEvent")
selection = NodePath("Selection")
orders = NodePath("Orders")
command_log = NodePath("Battle")
command_voice = NodePath("CommandVoice")
advisor = NodePath("AdvisorVoice")
advisor_watch = NodePath("AdvisorVoice/AdvisorWatch")

