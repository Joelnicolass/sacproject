[gd_resource type="Resource" script_class="FxSoundMap" load_steps=12 format=3]

[ext_resource type="Script" path="res://scenes/audio/sound_cue.gd" id="1_cue"]
[ext_resource type="Script" path="res://scenes/audio/fx_sound_map.gd" id="2_map"]
[ext_resource type="AudioStream" path="res://debug/audio/fixtures/custom_sounds/creatures/fixture/death_1.wav" id="3_a"]
[ext_resource type="AudioStream" path="res://debug/audio/fixtures/custom_sounds/creatures/fixture/death_2.wav" id="4_b"]
[ext_resource type="AudioStream" path="res://debug/audio/fixtures/beep_a.tres" id="5_loop"]

[sub_resource type="Resource" id="Cue_blood"]
script = ExtResource("1_cue")
streams = Array[AudioStream]([ExtResource("3_a"), ExtResource("4_b")])
max_voices = 0

[sub_resource type="Resource" id="Cue_lightning"]
script = ExtResource("1_cue")
streams = Array[AudioStream]([ExtResource("4_b")])
max_voices = 0

[sub_resource type="Resource" id="Cue_fireball_cast"]
script = ExtResource("1_cue")
streams = Array[AudioStream]([ExtResource("3_a")])
max_voices = 0

[sub_resource type="Resource" id="Cue_fountain_loop"]
script = ExtResource("1_cue")
streams = Array[AudioStream]([ExtResource("5_loop")])
max_distance_m = 60.0
priority = 20

[sub_resource type="Resource" id="Cue_manalith_loop"]
script = ExtResource("1_cue")
streams = Array[AudioStream]([ExtResource("5_loop")])
max_distance_m = 60.0
priority = 20

[sub_resource type="Resource" id="Cue_altar_loop"]
script = ExtResource("1_cue")
streams = Array[AudioStream]([ExtResource("5_loop")])
max_distance_m = 80.0
priority = 20

[resource]
script = ExtResource("2_map")
cues = Dictionary[StringName, ExtResource("1_cue")]({
&"blood": SubResource("Cue_blood"),
&"lightning": SubResource("Cue_lightning"),
&"fireball_cast": SubResource("Cue_fireball_cast"),
&"fountain_loop": SubResource("Cue_fountain_loop"),
&"manalith_loop": SubResource("Cue_manalith_loop"),
&"altar_loop": SubResource("Cue_altar_loop")
})
