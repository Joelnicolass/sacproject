[node name="DoctorPath" type="Node"]
editor_description = "RFC-024 024d (F75). Sac Doctor con pathfinding: un Farmer muere a >= 150 m del altar del slot 1 con un pilar de 22 m de radio en el medio del camino; el mago del slot 1 lanza Convert sobre su alma. El doctor portador tiene que ir al cadaver, bombear, llevarlo rodeando el pilar y el ritual del altar da el alma. Sin ventana: `--headless --fixed-fps 60 res://debug/doctor_path.tscn`. Opciones tras `--`: --nofollow (control: el portador pierde su PathFollower y se traba en el pilar), --nopillar, --distance=, --radius=, --timeout=. Imprime DOCTOR_PATH_RESULT {json} y DOCTOR_PATH PASS/FAIL."
script = ExtResource("1_runner")
world_scene = ExtResource("2_world")
rules = ExtResource("3_rules")
