[gd_scene load_steps=5 format=3]

[ext_resource type="PackedScene" path="res://scenes/world/high_noon.tscn" id="1_world"]
[ext_resource type="Resource" path="res://debug/rules/orders_group.tres" id="2_rules"]
[ext_resource type="PackedScene" path="res://scenes/world/units/unit.tscn" id="3_unit"]
[ext_resource type="Script" path="res://debug/escort_jam.gd" id="4_runner"]

[node name="EscortJam" type="Node"]
editor_description = "REVIEW-RFC-024d §2: ¿el mago HUMANO con escolta en guardia queda encerrado como el de la IA? El mago local (slot 1) con N Troggs propios en guardia (Orders.request «guard», la orden del jugador) camina 6 tramos con request_walk (clic en el suelo), dando la vuelta entre tramos. Informa por tramo segundos, llegada y segundos trabado (caminando y < 0,6 m por segundo, la misma prueba que AiWizardBrain._check_jam). --count=0 es el control sin escolta."

[node name="HighNoon" parent="." instance=ExtResource("1_world")]
rules = ExtResource("2_rules")

[node name="Camera" parent="HighNoon"]
start_zoom = 0.3

[node name="Arena" type="Node3D" parent="."]

[node name="Overlay" type="CanvasLayer" parent="."]
layer = 2

[node name="Status" type="Label" parent="Overlay"]
offset_left = 24.0
offset_top = 80.0
offset_right = 1150.0
offset_bottom = 130.0
mouse_filter = 2
text = "Escolta"
theme_override_font_sizes/font_size = 24
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6

[node name="Runner" type="Node" parent="." node_paths=PackedStringArray("world", "arena", "status_label")]
script = ExtResource("4_runner")
world = NodePath("../HighNoon")
unit_scene = ExtResource("3_unit")
arena = NodePath("../Arena")
status_label = NodePath("../Overlay/Status")

[node name="Population" parent="HighNoon"]
spawn_creatures = false
