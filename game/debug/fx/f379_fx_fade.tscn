[node name="F379FxFade" type="Node3D"]
editor_description = "RFC-053 053i (F379): los efectos terminan con un fundido, no con un corte. Sin ventana imprime FX_FADE <caso> PASS|FAIL y FX_FADE PASS: la chispa corta (rock_spark) cae en attack + min_decay_s de FxLightLayer; una luz que pierde su lugar se funde en fade_out_s; bajar el tope de luces funde las que sobran en vez de cortarlas; toda rafaga de data/fx termina en alfa 0 (cola tail_fade_s de SpriteParticles); la capa liberada no deja nodos huerfanos. Los tiempos se editan en el inspector: FxLight (fade_out_s, max_fading, min_decay_s) en scenes/look/fx/fx_light_layer.tscn y tail_fade_s en scenes/fx/sprite_particles.tscn."
script = ExtResource("1_fade")
strong = ExtResource("3_strong")
spark = ExtResource("4_spark")
sprite_particles = ExtResource("5_particles")

[node name="Camera3D" type="Camera3D" parent="."]
current = true

[node name="FxLight" parent="." instance=ExtResource("2_layer")]
unique_name_in_owner = true
