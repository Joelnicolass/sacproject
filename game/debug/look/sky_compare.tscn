[gd_scene format=3]

[ext_resource type="Script" path="res://debug/look/sky_compare.gd" id="1_run"]
[ext_resource type="PackedScene" path="res://debug/look/sky_reference/sky.tscn" id="2_sky"]
[ext_resource type="Shader" path="res://scenes/look/sky/sacrifice_sky.gdshader" id="3_shader"]

[sub_resource type="Environment" id="Environment_old"]
background_mode = 1
background_color = Color(0.7843, 1, 0.9804, 1)

[sub_resource type="ShaderMaterial" id="ShaderMaterial_new"]
shader = ExtResource("3_shader")

[sub_resource type="Sky" id="Sky_new"]
sky_material = SubResource("ShaderMaterial_new")
process_mode = 1

[sub_resource type="Environment" id="Environment_new"]
background_mode = 2
sky = SubResource("Sky_new")

[node name="SkyCompare" type="Node" node_paths=PackedStringArray("old_viewport", "new_viewport", "old_environment", "old_camera", "new_camera", "old_sky", "new_environment")]
script = ExtResource("1_run")
old_viewport = NodePath("Layout/OldContainer/OldViewport")
new_viewport = NodePath("Layout/NewContainer/NewViewport")
old_environment = NodePath("Layout/OldContainer/OldViewport/OldEnvironment")
old_camera = NodePath("Layout/OldContainer/OldViewport/OldCamera")
new_camera = NodePath("Layout/NewContainer/NewViewport/NewCamera")
old_sky = NodePath("Layout/OldContainer/OldViewport/Sky")
new_environment = NodePath("Layout/NewContainer/NewViewport/NewEnvironment")

[node name="Layout" type="HBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="OldContainer" type="SubViewportContainer" parent="Layout"]
layout_mode = 2
stretch = true

[node name="OldViewport" type="SubViewport" parent="Layout/OldContainer"]
own_world_3d = true
size = Vector2i(320, 180)
render_target_update_mode = 4

[node name="OldEnvironment" type="WorldEnvironment" parent="Layout/OldContainer/OldViewport"]
environment = SubResource("Environment_old")

[node name="OldCamera" type="Camera3D" parent="Layout/OldContainer/OldViewport"]
fov = 75.0
far = 20000.0

[node name="Sky" parent="Layout/OldContainer/OldViewport" instance=ExtResource("2_sky")]

[node name="NewContainer" type="SubViewportContainer" parent="Layout"]
layout_mode = 2
stretch = true

[node name="NewViewport" type="SubViewport" parent="Layout/NewContainer"]
own_world_3d = true
size = Vector2i(320, 180)
render_target_update_mode = 4

[node name="NewEnvironment" type="WorldEnvironment" parent="Layout/NewContainer/NewViewport"]
environment = SubResource("Environment_new")

[node name="NewCamera" type="Camera3D" parent="Layout/NewContainer/NewViewport"]
fov = 75.0
far = 20000.0
