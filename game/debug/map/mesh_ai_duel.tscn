[node name="MeshAiDuel" instance=ExtResource("1_match")]
editor_description = "RFC-063 063-2a. Dos IA Normal (slot 1 y 2, James) en la isla de malla libre, sin NPC; FallWatch cuenta los cuerpos que caen (FallCheck.has_fallen) y a los 180 s imprime MESH FALL PASS o FAIL y cierra. Sin ventana: `Godot --headless --path game --fixed-fps 60 res://debug/map/mesh_ai_duel.tscn -- --map=mesh_test --minutes=3 --watchdog-s=1500`. El navmesh de mesh_test se hornea antes: `Godot --headless --path game res://tools/bake/bake_nav.tscn -- --map=mesh_test`."

