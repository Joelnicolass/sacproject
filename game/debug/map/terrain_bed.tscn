[node name="Terrain" type="Node3D"]
editor_description = "Un suelo sin malla para verificar el terreno deformable: el Terrain (Shape) de High Noon, su Net y su Collision por trozos. Lo usan terrain_cases y terrain_late_join; no tiene look. Remote → Shape/Status muestra rev, version, live_stamps y holes."

[node name="Shape" type="Node3D" parent="." node_paths=PackedStringArray("net")]
script = ExtResource("1_shape")
data = ExtResource("4_data")
tiles = ExtResource("5_tiles")
net = NodePath("../Net")

[node name="Status" type="Node" parent="Shape" node_paths=PackedStringArray("terrain")]
script = ExtResource("6_status")
terrain = NodePath("..")

[node name="Net" type="Node" parent="."]
script = ExtResource("2_net")

[node name="Collision" type="StaticBody3D" parent="." node_paths=PackedStringArray("shape")]
