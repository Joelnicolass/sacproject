[node name="TerrainDeformBench" type="Node"]
editor_description = "Bench del costo de deformar el terreno (diagnóstico 063D). F6 con ventana: imprime por fase (quieto, sello vivo de Volcano cada tick, 5 Quakes a la vez una tanda tras otra, agujeros de Bore) el tiempo de script por tick, el frame, cada llamada al Terrain y lo que TerrainDeformTexture sube a la GPU (upload_kb, upload_us). Meta: el sello vivo suma <= 1 ms por tick y ningún frame pasa de 20 ms; F4: <= 10 KB y <= 20 us por frame con un sello vivo. Al final, TERRAIN DEFORM BENCH PASS si los 5 Quakes suman <= 1 ms al tick promedio de la base y ningún frame suyo pasa de 20 ms (RFC-057, criterio 10)."
script = ExtResource("1_bench")
world_scene = ExtResource("2_world")
quality = ExtResource("3_quality")
live_zone = ExtResource("4_volcano")
quake_scene = ExtResource("5_quake")
