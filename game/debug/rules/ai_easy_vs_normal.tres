[gd_resource type="Resource" script_class="BenchRules" load_steps=6 format=3]

[ext_resource type="Script" path="res://debug/bench_rules.gd" id="1_rules"]
[ext_resource type="Script" path="res://scenes/ai/data/ai_seat.gd" id="2_seat"]
[ext_resource type="Resource" path="res://data/ai/difficulty_easy.tres" id="3_easy"]
[ext_resource type="Resource" path="res://data/ai/difficulty_normal.tres" id="4_normal"]

; RFC-024 024e: IA Facil (slot 1) contra IA Normal (slot 2), los dos con James y su perfil por dios, NPC presentes, sin estructuras
; puestas (cada IA levanta su Manalith). 10 semillas, 30 min: Normal gana >= 7/10; convocatorias de Facil a los 5 min <= 70 % de las
; de Normal (--checkpoints=5,10). Lados cambiados: --difficulties=normal,easy.

[sub_resource type="Resource" id="Seat_easy"]
script = ExtResource("2_seat")
slot = 1
wizard = "cwa0"
god = &"james"
difficulty = ExtResource("3_easy")

[sub_resource type="Resource" id="Seat_normal"]
script = ExtResource("2_seat")
slot = 2
wizard = "cwa0"
god = &"james"
difficulty = ExtResource("4_normal")

[resource]
script = ExtResource("1_rules")
starting_souls = 12
biome_god = &"james"
match_seed = 1
anchor = Vector3(1270, 0, 1270)
start_paused = true
npcs = true
ai_seats = Array[ExtResource("2_seat")]([SubResource("Seat_easy"), SubResource("Seat_normal")])
pending_text = "IA Fácil contra IA Normal en pausa"
ignore_annihilation = true
