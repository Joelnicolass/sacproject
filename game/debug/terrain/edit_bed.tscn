[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/map/map_root.gd" id="1_root"]
[ext_resource type="Script" path="res://scenes/map/props/map_props.gd" id="2_props"]
[ext_resource type="PackedScene" path="res://scenes/map/props/player_start.tscn" id="3_start"]
[ext_resource type="PackedScene" path="res://scenes/map/props/manafount.tscn" id="4_fount"]
[ext_resource type="PackedScene" path="res://scenes/look/look_rig.tscn" id="5_look"]
[ext_resource type="PackedScene" path="res://scenes/map/terrain/terrain.tscn" id="6_terrain"]
[ext_resource type="Resource" path="res://debug/terrain/edit_bed/heights.png" id="7_heights"]
[ext_resource type="Texture2D" path="res://scenes/map/maps/test_flat/ground_roles.png" id="8_roles"]

[node name="EditBed" type="Node3D" node_paths=PackedStringArray("terrain", "starts", "look")]
editor_description = "Banco de las herramientas del suelo (plan 063D S4c/S5b): una isla plana de 600 x 600 m a 50 m (debug/terrain/edit_bed/heights.png + void.png), con un PlayerStart y un Manafount. Sin NavRegion: «Validar mapa» revisa lo que está sobre tierra y las bases, no los caminos. Seleccioná Terrain: arriba del 3D aparece la barra «Terreno:» (Subir/Bajar, Suavizar, Hueco); en el inspector, Abrir/Traer de Blender, Suelo plano nuevo, Aplanar bases y Validar mapa. Ctrl+S escribe las imágenes. Lo que todavía no está: la loma, el hueco o la base desnivelada que traen los pinceles."
script = ExtResource("1_root")
terrain = NodePath("Terrain")
starts = NodePath("MapProps/Starts")
look = NodePath("Look")

[node name="Look" parent="." node_paths=PackedStringArray("terrain") instance=ExtResource("5_look")]
terrain = NodePath("../Terrain")

[node name="Terrain" parent="." instance=ExtResource("6_terrain")]
heights = ExtResource("7_heights")
ground_roles = ExtResource("8_roles")

[node name="MapProps" type="Node3D" parent="."]
script = ExtResource("2_props")

[node name="Starts" type="Node3D" parent="MapProps"]

[node name="Start1" parent="MapProps/Starts" instance=ExtResource("3_start")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1180, 50, 1280)

[node name="Founts" type="Node3D" parent="MapProps"]

[node name="Fount1" parent="MapProps/Founts" instance=ExtResource("4_fount")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1380, 50, 1280)
