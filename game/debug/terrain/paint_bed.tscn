[node name="PaintBed" type="Node3D" node_paths=PackedStringArray("terrain", "starts", "look")]
editor_description = "Banco de los pinceles de roles y de flora (plan 066): la isla plana de 600 x 600 m a 50 m de edit_bed (sus heights.png + void.png, que acá no se pintan), con roles propios en paint_bed/ground_roles.png (todo pasto, (255,0,0,0)), Look con Persephone (el único dios con GodGround: sin él los roles no se ven) y calidad media, un PlayerStart, un Manafount y Vegetation/Ferns (FloraLayer de helechos de Persephone, todavía sin imagen de densidad: el inspector avisa). Seleccioná Terrain para Relieve y Roles, o Ferns para Flora; clic izquierdo y arrastrá en el 3D, Shift borra la flora, Ctrl+Z deshace, Ctrl+S guarda. Lo que todavía no está: roca ni camino en el suelo y ningún helecho."
script = ExtResource("1_root")
terrain = NodePath("Terrain")
starts = NodePath("MapProps/Starts")
look = NodePath("Look")

[node name="Look" parent="." node_paths=PackedStringArray("terrain") instance=ExtResource("5_look")]
terrain = NodePath("../Terrain")
preview_god = ExtResource("9_god")
preview_quality = ExtResource("10_quality")

