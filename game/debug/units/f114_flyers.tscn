[node name="F114Flyers" instance=ExtResource("1_match")]
editor_description = "RFC-030 030e (F116). Voladoras híbridas: las 9 del RFC (Blight, Gremlin, Ikarus, Pyrodactyl, Seraph, Dragon, Hellmouth, Rhinok, Silverback) más Phoenix, propias (bando 1), en tierra y en fila norte-sur cada 10 m, a 150 m al oeste del manantial central (1270, 1270). Sin enemigas. Enter (check_tick), seleccionarlas con rectángulo y clic derecho en el manantial: despegan (clip takeoff), vuelan a flying_speed y aterrizan al llegar. Clic derecho a 5 m: caminan. Rhinok no tiene clip de vuelo (sacengine canFly = no) y camina siempre; Phoenix no tiene takeoff ni land y despega en el acto."

