[node name="F155Oil" instance=ExtResource("1_match")]
editor_description = "RFC-030 030r-b (F155). Viscous oil del Pyrodactyl (kcfa) desde el manantial central (1270, 1270), semilla 7. Carril O: Pyrodactyl1 (slot 1, 300 de maná, pacifista) en -25/-35 lanza el aceite al punto (1270, 1235) a los 0,5 s (prepara 94 ticks, maná 300->240, enfriamiento 360). O1 = Druid1 (slot 2) en 0/-35; O2 = Druid2 (slot 2) en +2/-35; O3 = Druid3 (slot 1, aliado) en 0/-32; O4 = Druid4 (slot 2) en +18/-35 (fuera del radio de 15); O5 = Trogg1 (slot 2) en 0/-48 camina hacia FM a los 2,5 s y el aceite lo frena; FM = FlameMinion1 (slot 1, NO pacifista: no puede estar quieto y recibir la orden de atacar, así que escupe fuego (fkba) a Druid1 por su cuenta). Cuando un fkba alcanza a un untado, el daño se duplica y el aceite explota al tick siguiente (500 de salpicadura, radio 5, ignite). 0,4 min. Enter (check_tick) arranca. Réplica: agent/tools/f155_expect.py."

