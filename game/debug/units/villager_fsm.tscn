[node name="VillagerFsm" type="Node3D" node_paths=PackedStringArray("farmer", "lone", "hunter")]
editor_description = "055c4. La FSM del aldeano (Brain: Idle, Work, Flee, Cower). Farmer: un campesino del lado 3 con una casa (refugio) a 30 m. Hunter: un Trogg del lado 1 a 30 m del Farmer. Lone: otro campesino a 300 m de cualquier refugio. Arrastrá cualquiera con el gizmo y corré de nuevo (F6); abrí el Brain del Farmer para ver los cuatro estados y cambiá flee_leg_m, think_interval_s o work_role en el inspector. Verifica: un nodo por estado, trabaja con refugio y sin amenaza, huye de una amenaza a 30 m y no de una a 51 m, un golpe lo hace huir aunque el agresor esté lejos y sin refugio se encoge. Sin ventana: `--headless res://debug/units/villager_fsm.tscn` imprime VILLAGER_FSM PASS/FAIL."
script = ExtResource("1_runner")
farmer = NodePath("Farmer")
lone = NodePath("Lone")
hunter = NodePath("Hunter")

