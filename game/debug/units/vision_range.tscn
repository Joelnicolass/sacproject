[node name="VisionRange" type="Node3D" node_paths=PackedStringArray("seer", "foes", "far_foe", "behind_foe")]
editor_description = "055c2. Un Trogg (lado 1, ve 100 m, mira a +Z) y cinco Druids quietos del lado 2: tres dentro del alcance (50, 72 y 85 m; en el árbol van C, A, B para que el orden del árbol no sea el de nombre), uno justo afuera (110 m) y uno detrás (60 m). Arrastrá cualquiera con el gizmo y corré de nuevo (F6): la visión se ve en el cilindro del Vision del Trogg. Verifica quién ve, el orden por nombre, el radio a mano, el cono, cilindro contra esfera, el área de física contra recorrer los grupos y el olvido del bando. Sin ventana: `--headless res://debug/units/vision_range.tscn` imprime VISION_RANGE PASS/FAIL."
script = ExtResource("1_runner")
seer = NodePath("Seer")
foes = [NodePath("FoeC"), NodePath("FoeA"), NodePath("FoeB")]
far_foe = NodePath("FoeFar")
behind_foe = NodePath("FoeBehind")

