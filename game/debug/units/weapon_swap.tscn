[node name="WeaponSwap" type="Node3D" node_paths=PackedStringArray("plain", "added", "removed", "changed", "foe")]
editor_description = "055c3. Cuatro criaturas con las armas cambiadas SOLO en el editor, sin código. Plain: un Trogg tal cual. Added: un Trogg con un ranged_weapon.tscn soltado bajo su Weapons (Spit; su attack_type es el disparo del Earthfling). Removed: un Earthfling con el arma Ranged apagada (enabled). Changed: un Silverback cuya arma Ranged dispara la piedra del Earthfling en vez de su aliento. Foe: un Druid a 20 m frente a Added. Para probarlo con tus manos: abrí un nodo Weapons, arrastrá o borrá sus hijos, o cambiá attack_type, y corré (F6). La prioridad es el orden de los hijos. Sin ventana: `--headless res://debug/units/weapon_swap.tscn` imprime WEAPON_SWAP PASS/FAIL."
script = ExtResource("1_runner")
plain = NodePath("Plain")
added = NodePath("Added")
removed = NodePath("Removed")
changed = NodePath("Changed")
foe = NodePath("Foe")

