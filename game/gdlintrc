# gdlint settings (gdtoolkit 4.x). See CONTRIBUTING.md §4 and §9.
# Run from game/: gdlint scenes tools test

# Size limits (CONTRIBUTING §4: split by responsibility, these only warn at the extremes).
max-line-length: 100
# A tab counts as 4 columns, the editor's default indent size.
tab-characters: 4
max-file-lines: 1000
max-public-methods: 20
max-returns: 6
function-arguments-number: 10

# Order inside a script (CONTRIBUTING §4, same as the official style guide).
class-definitions-order:
- tools
- classnames
- extends
- docstrings
- signals
- enums
- consts
- staticvars
- exports
- pubvars
- prvvars
- onreadypubvars
- onreadyprvvars
- others

# Names (CONTRIBUTING §4: PascalCase classes, snake_case members, CONSTANT_CASE constants).
class-name: ([A-Z][a-z0-9]*)+
sub-class-name: _?([A-Z][a-z0-9]*)+
class-load-variable-name: (([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
class-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
constant-name: _?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*
load-constant-name: (([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)
enum-name: ([A-Z][a-z0-9]*)+
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
function-name: (_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
function-argument-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
function-variable-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
function-preload-variable-name: ([A-Z][a-z0-9]*)+
loop-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
signal-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'

# Checks without settings (null = on).
comparison-with-itself: null
duplicated-load: null
expression-not-assigned: null
mixed-tabs-and-spaces: null
no-elif-return: null
no-else-return: null
trailing-whitespace: null
unnecessary-pass: null
unused-argument: null

# No rule clashes with a documented project choice, so nothing is disabled.
disable: []

# External kits are edited in their own repos; agent/ is disposable and not versioned.
excluded_directories: !!set
  .git: null
  .godot: null
  addons: null
  agent: null
