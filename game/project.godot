; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sacrifice"
run/main_scene="res://scenes/core/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

MpKit="*res://addons/mp_kit/mp_kit.gd"
MpLobby="*res://addons/mp_kit/lobby/mp_lobby.gd"
GameData="*res://scenes/core/catalog/game_data.gd"
SacrificeFlow="*res://scenes/core/flow/sacrifice_flow.tscn"
AgentKit="*res://addons/agent_kit/agent_kit.gd"
FxBus="*res://scenes/fx/fx_bus.tscn"
SoundBus="*res://scenes/audio/sound_bus.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/mp_kit/plugin.cfg", "res://addons/agent_kit/plugin.cfg", "res://addons/fsm_kit/plugin.cfg", "res://addons/sacrifice_tools/plugin.cfg", "res://addons/terrain_tools/plugin.cfg")

[gui]

theme/custom="res://data/ui/theme.tres"

