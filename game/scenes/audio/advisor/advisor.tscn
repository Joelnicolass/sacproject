[node name="AdvisorVoice" type="Node" node_paths=PackedStringArray("channel")]
editor_description = "El consejero: un canal con cola y prioridad (Channel, bus Voice). Los rechazos llegan por command_log (CommandLog.said) y salen de refusal_lines; los avisos del juego, por el hijo AdvisorWatch. Cada AdvisorLine trae su sonido, su prioridad y su silencio. Sin audio (dedicado, headless) no dice nada."
script = ExtResource("1_voice")
channel = NodePath("Channel")
refusal_lines = Dictionary[StringName, ExtResource("3_line")]({
&"no_mana": SubResource("Line_low_mana"),
&"cooling": SubResource("Line_not_ready"),
&"out_of_range": SubResource("Line_out_of_range"),
&"bad_target": SubResource("Line_invalid_target"),
&"no_target": SubResource("Line_invalid_target"),
&"no_fount": SubResource("Line_invalid_target"),
&"fount_taken": SubResource("Line_invalid_target"),
&"occupied": SubResource("Line_invalid_target"),
&"no_souls": SubResource("Line_need_souls"),
&"far_from_altar": SubResource("Line_far_from_altar")
})

[node name="Channel" type="AudioStreamPlayer" parent="."]
bus = &"Voice"

[node name="AdvisorWatch" type="Node" parent="." node_paths=PackedStringArray("advisor")]
editor_description = "Los avisos del juego (el mago local recibe daño, un edificio o una criatura propia caen, el altar se profana): lee estado replicado y le pide una línea al consejero. Sacá el nodo y solo hablan los rechazos."
script = ExtResource("2_watch")
advisor = NodePath("..")
wizard_attacked = SubResource("Line_wizard_attacked")
wizard_low_health = SubResource("Line_wizard_low_health")
creatures_attacked = SubResource("Line_creatures_attacked")
creature_died = SubResource("Line_creature_died")
building_attacked = SubResource("Line_building_attacked")
building_destroyed = SubResource("Line_building_destroyed")
desecrated = SubResource("Line_desecrated")
sacrifice_complete = SubResource("Line_sacrifice_complete")
