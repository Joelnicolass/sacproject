[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/audio/ambience_director.gd" id="1_director"]

[node name="AmbienceDirector" type="Node" node_paths=PackedStringArray("bed")]
editor_description = "The god's ambience. A background loop (Bed, Ambience bus) and random 3D one-shots around the listener (AmbienceSet.one_shots). The set is `ambience` or the one of the god that `biome` applies (LookProfile.ambience of the god's look). Without audio (dedicated, headless) the player stays still."
script = ExtResource("1_director")
bed = NodePath("Bed")

[node name="Bed" type="AudioStreamPlayer" parent="."]
bus = &"Ambience"
