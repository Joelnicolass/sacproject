[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/audio/music_director.gd" id="1_director"]

[node name="MusicDirector" type="Node" node_paths=PackedStringArray("track_a", "track_b")]
editor_description = "The music. Two players with a crossfade (TrackA and TrackB, Music bus); the mood is decided by MusicMood with CombatGauge (gauge), the end of the match and the rituals (Events). The set is `music` (the menu's in boot.tscn) or the one of the god that `biome` applies (LookProfile.music of the god's look; without a set of its own, `default_music`). Without audio (dedicated, headless) the players stay still."
script = ExtResource("1_director")
track_a = NodePath("TrackA")
track_b = NodePath("TrackB")

[node name="TrackA" type="AudioStreamPlayer" parent="."]
bus = &"Music"

[node name="TrackB" type="AudioStreamPlayer" parent="."]
bus = &"Music"
