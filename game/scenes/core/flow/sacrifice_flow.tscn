[gd_scene load_steps=10 format=3]

[ext_resource type="Script" uid="uid://lfuoh6n1jq8h" path="res://scenes/core/flow/sacrifice_flow.gd" id="1_flow"]
[ext_resource type="Script" path="res://scenes/core/flow/wizard_pick.gd" id="2_pick"]
[ext_resource type="Resource" path="res://data/catalog/wizards/jadugarr.tres" id="3_wizard"]
[ext_resource type="Resource" uid="uid://dxr20hx8hlmpf" path="res://data/gods/james.tres" id="4_god"]
[ext_resource type="Resource" path="res://data/ai/seat_vs_ai.tres" id="5_seat"]
[ext_resource type="Script" path="res://scenes/net/pick_board.gd" id="6_board"]
[ext_resource type="Script" path="res://scenes/net/seat_presence.gd" id="7_presence"]
