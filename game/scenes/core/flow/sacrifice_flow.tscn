[sub_resource type="Resource" id="Resource_pick"]
script = ExtResource("2_pick")
wizard = ExtResource("3_wizard")
god = ExtResource("4_god")

[node name="SacrificeFlow" type="Node" node_paths=PackedStringArray("board", "presence", "loading_screen")]
editor_description = "El autoload que lleva al jugador del menú a la partida (solo, contra la IA, sala, servidor local, salas online). default_pick es lo que está elegido al abrir el menú; vs_ai_seat es el rival de «Contra la IA». Los dos se cambian acá arrastrando un mago, un dios o un asiento. El grupo «Match start» es la puerta de la partida en red: gracia para volver, tiempo de carga, asientos para arrancar (start_seats, en el host LAN y en el dedicado a mano: 0 = todos, o los que cargaron pasado load_timeout_s; las corridas con un cliente pasan --start-seats=1) y si los clientes esperan pausados. load_timeout_s queda en 60 s (el kit trae 15): el precalentado puede tardar hasta 20 s y el que todavía precalienta no tiene que quedar afuera. El grupo «Online (issuer)» tiene claves de data/i18n/strings.csv (UI_ONLINE_*): un texto nuevo es una fila ahí y una entrada en online_texts. world_reports_loaded: la partida espera a que el mundo avise que está listo (precalentado), detrás de LoadingScreen; también en solo."
script = ExtResource("1_flow")
default_pick = SubResource("Resource_pick")
vs_ai_seat = ExtResource("5_seat")
board = NodePath("PickBoard")
presence = NodePath("SeatPresence")
loading_screen = NodePath("LoadingScreen")
world_reports_loaded = true
rejoin_grace_s = 60.0
load_timeout_s = 60.0
start_seats = 0
pause_clients = true
room_name = "Sacrifice"
online_working_status = "UI_ONLINE_WORKING"
online_ready_status = "UI_ONLINE_READY"
online_texts = {
"banned": "UI_ONLINE_BANNED",
"kit_too_old": "UI_ONLINE_KIT_TOO_OLD",
"network": "UI_ONLINE_NETWORK",
"no_issuer": "UI_ONLINE_NO_ISSUER",
"no_such_room": "UI_ONLINE_NO_SUCH_ROOM",
"rate_limited": "UI_ONLINE_RATE_LIMITED",
"room_full": "UI_ONLINE_ROOM_FULL",
"room_starting": "UI_ONLINE_ROOM_STARTING",
"too_many_rooms": "UI_ONLINE_TOO_MANY_ROOMS",
"version_mismatch": "UI_ONLINE_VERSION_MISMATCH",
"version_too_old": "UI_ONLINE_VERSION_TOO_OLD"
}
online_error_status = "UI_ONLINE_ERROR"
host_silent_status = "UI_ONLINE_HOST_SILENT"

[node name="PickBoard" type="Node" parent="."]
editor_description = "Los picks de cada asiento: el servidor guarda lo que manda cada cliente y publica la tabla; el cliente copia la que recibe."
script = ExtResource("6_board")

[node name="SeatPresence" type="Node" parent="."]
editor_description = "El relato de cada asiento en el log del servidor (adentro, cargó, arranca, se fue o volvió, rechazado, abandonó) y la derrota del que abandona. Sacarlo apaga la derrota por abandono en LAN."
script = ExtResource("7_presence")

[node name="LoadingScreen" parent="." instance=ExtResource("8_loading")]
editor_description = "La pantalla negra mientras carga la partida (título, fase, barra fina). Escucha world_load_progressed del flow; se va con un fundido cuando el mundo avisa que está listo. Borrarla quita la pantalla; la carga sigue igual."
