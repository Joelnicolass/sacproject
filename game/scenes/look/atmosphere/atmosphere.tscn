[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/look/atmosphere/atmosphere.gd" id="1_atmosphere"]
[ext_resource type="Script" path="res://scenes/look/atmosphere/time_of_day.gd" id="2_time"]
[ext_resource type="Script" path="res://scenes/look/atmosphere/weather.gd" id="3_weather"]
[ext_resource type="Script" path="res://scenes/look/atmosphere/precipitation_fall.gd" id="4_fall"]
[ext_resource type="Script" path="res://scenes/look/follow_camera.gd" id="5_follow"]
[ext_resource type="Script" path="res://scenes/look/atmosphere/storm_strikes.gd" id="6_storm"]
[ext_resource type="Resource" path="res://data/fx/beams/storm_bolt.tres" id="7_bolt"]
[ext_resource type="Resource" path="res://data/fx/storm_flash.tres" id="8_flash"]
[ext_resource type="Resource" path="res://data/audio/cues/thunder.tres" id="9_thunder"]

[node name="Atmosphere" type="Node3D"]
editor_description = "La hora y el clima de ahora: el sol, el entorno y la vida los leen (señal changed). Oculto = la luz aprobada, exacta."
script = ExtResource("1_atmosphere")

[node name="TimeOfDay" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("2_time")

[node name="Weather" type="Node3D" parent="." node_paths=PackedStringArray("precipitation", "storm")]
unique_name_in_owner = true
script = ExtResource("3_weather")
precipitation = NodePath("Precipitation")
storm = NodePath("Storm")

[node name="Precipitation" type="Node3D" parent="Weather" node_paths=PackedStringArray("drops", "bed")]
script = ExtResource("4_fall")
drops = NodePath("Follow/Drops")
bed = NodePath("Bed")

[node name="Follow" type="Node3D" parent="Weather/Precipitation"]
script = ExtResource("5_follow")

[node name="Drops" type="GPUParticles3D" parent="Weather/Precipitation/Follow"]
editor_description = "Las gotas (o los copos) alrededor de la cámara. Qué cae y cuánto lo dice el estado del clima (PrecipitationLook)."
emitting = false
amount = 4000
lifetime = 1.6
local_coords = false
visibility_aabb = AABB(-40, -20, -40, 80, 60, 80)

[node name="Bed" type="AudioStreamPlayer" parent="Weather/Precipitation"]
bus = &"Ambience"

[node name="Storm" type="Node" parent="Weather"]
editor_description = "Los rayos de la tormenta: caen a 150-600 m de la cámara, el mismo instante y rumbo para todos, con ≥ 4 s entre destellos. Haz, destello con luz y trueno con retardo (distancia / 343). Cuántos caen lo dice el estado del clima (strikes_per_min)."
script = ExtResource("6_storm")
bolt = ExtResource("7_bolt")
flash = ExtResource("8_flash")
thunder = ExtResource("9_thunder")
