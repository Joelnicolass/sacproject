[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/look/look_rig.gd" id="1_rig"]
[ext_resource type="Script" path="res://scenes/look/quality_applier.gd" id="2_quality"]
[ext_resource type="PackedScene" path="res://scenes/look/light/light_layer.tscn" id="3_light"]
[ext_resource type="PackedScene" path="res://scenes/look/ground/terrain_layer.tscn" id="4_ground"]
[ext_resource type="PackedScene" path="res://scenes/look/sky/sky_layer.tscn" id="5_sky"]
[ext_resource type="PackedScene" path="res://scenes/look/grass/grass_layer.tscn" id="6_grass"]
[ext_resource type="PackedScene" path="res://scenes/look/fx/fx_light_layer.tscn" id="7_fx_light"]
[ext_resource type="PackedScene" path="res://scenes/look/vegetation/flora_layer.tscn" id="8_flora"]

[node name="Look" type="Node" node_paths=PackedStringArray("layers", "quality")]
script = ExtResource("1_rig")
layers = NodePath("Layers")
quality = NodePath("Quality")

[node name="Layers" type="Node" parent="."]

[node name="Light" parent="Layers" instance=ExtResource("3_light")]

[node name="Ground" parent="Layers" instance=ExtResource("4_ground")]

[node name="Sky" parent="Layers" instance=ExtResource("5_sky")]

[node name="Grass" parent="Layers" instance=ExtResource("6_grass")]

[node name="FxLight" parent="Layers" instance=ExtResource("7_fx_light")]

[node name="Flora" parent="Layers" node_paths=PackedStringArray("rig") instance=ExtResource("8_flora")]
rig = NodePath("../..")

[node name="Quality" type="Node" parent="."]
script = ExtResource("2_quality")
