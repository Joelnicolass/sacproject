[node name="Map" type="Node3D" node_paths=PackedStringArray("terrain", "nav", "starts", "look", "minimap_bake", "buildings", "npcs", "props")]
script = ExtResource("1_root")
terrain = NodePath("Terrain")
nav = NodePath("Nav")
starts = NodePath("MapProps/Starts")
look = NodePath("Look")
minimap_bake = NodePath("MinimapBake")
buildings = NodePath("Buildings")
npcs = NodePath("Npcs")
props = NodePath("Props")

[node name="Look" parent="." node_paths=PackedStringArray("terrain") instance=ExtResource("7_look")]
unique_name_in_owner = true
terrain = NodePath("../Terrain")
preview_god = ExtResource("8_god")
preview_quality = ExtResource("9_quality")

[node name="Terrain" parent="." instance=ExtResource("11_terrain")]
unique_name_in_owner = true
