editor_description = "The piece of ground that falls when a vertex is removed (Bore): the triangles that touched it, with the ground's look, fall at 30 m/s2 down to 100 m below. FxBus.broadcast_scene plays it with `at` (where the ground went). The camera shake is this root's `camera_trauma`; the mesh is built in Mesh."
script = ExtResource("1_chunk")
camera_trauma = 0.15

