[node name="GroundScars" type="Node3D"]
editor_description = "Las marcas en el suelo del mapa (quemaduras, grietas, crateres): unico dueno de las baldosas pintadas. Hijo de Terrain; `terrain` es el Terrain del mapa. Cantidad maxima de baldosas: la opcion «Cantidad de marcas» (prefs)."
script = ExtResource("1_scars")
prefs = ExtResource("2_prefs")
tiles = SubResource("Tiles_scars")

[node name="Net" type="Node" parent="." node_paths=PackedStringArray("scars")]
editor_description = "Pone al dia las marcas del suelo de un jugador que vuelve tras una caida: el servidor le manda la lista de lo pintado (la suya si dibuja, o la de un jugador ya conectado). Nada viaja por marca."
script = ExtResource("3_net")
scars = NodePath("..")
