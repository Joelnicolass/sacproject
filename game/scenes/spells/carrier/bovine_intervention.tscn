[node name="BovineIntervention" type="Node3D" node_paths=PackedStringArray("fall")]
editor_description = "Bovine Intervention (ivob): una vaca (bovi, 65 cuadros del original, x4) nace 4 m bajo tierra a 15 m delante del mago al terminar el lanzamiento y cae sobre el blanco en 12 s en parabola de 200 m de pico; a los 12 s lo gibea (su alma queda) y al atravesar el suelo revienta: 16 rocas, 100 rocas y polvo y una onda que aturde hasta 25 m. Luz de tierra (dirt)."
