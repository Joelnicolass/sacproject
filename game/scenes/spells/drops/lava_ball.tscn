[node name="LavaBall" type="Node3D"]
editor_description = "Una bola de lava del Volcano: una roca que sale de la boca (hasta 120 m sobre el suelo) con la velocidad del hechizo (30 m/s) inclinada hacia arriba para compensar la gravedad (30 m/s²), deja un rastro de fuego y explota al tocar el suelo o la primera criatura (caja de 2 m): el daño del hechizo en el golpe y en la salpicadura de 10 m, con fuego de 1 s. Vive 20 s como mucho."
script = ExtResource("drop")
gravity_m_s2 = 30.0
contact_m = 2.0
contact_height_m = 400.0
max_age_s = 20.0

