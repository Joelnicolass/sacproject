[node name="Meteor" type="Node3D"]
editor_description = "Un meteorito de Bombardment: sale de la tierra, cruza el cielo en un arco de 12 s (gravedad 20) y solo choca bajando, con una caja de 3 m; al llegar, 400 de dano de hechizo, salpicadura de 5 m que aturde 8 s, piedras, polvo y temblor. Al llegar deja una abolladura permanente: el sello Dent (-sqrt(1 - d^2/15^2) * 1,2 m; radio y profundidad son su cilindro Reach, la forma su StampProfile) y DropDent lo aplica donde termina el vuelo."
script = ExtResource("drop")
gravity_m_s2 = 20.0
contact_m = 3.0
only_descending = true
lobbed = true

