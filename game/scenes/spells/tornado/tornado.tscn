[sub_resource type="ShaderMaterial" id="Material_upper"]
resource_local_to_scene = true
shader = ExtResource("9_shader")
shader_parameter/part = 0
shader_parameter/skin = ExtResource("12_trn1")

[sub_resource type="ShaderMaterial" id="Material_lower"]
resource_local_to_scene = true
shader = ExtResource("9_shader")
shader_parameter/part = 1
shader_parameter/skin = ExtResource("13_trn2")

[sub_resource type="ShaderMaterial" id="Material_edge"]
resource_local_to_scene = true
shader = ExtResource("9_shader")
shader_parameter/part = 2
shader_parameter/skin = ExtResource("14_edge")
shader_parameter/energy = 2.6

[node name="Tornado" type="Node3D"]
editor_description = "Tornado (nrot): un embudo de 500 m que crece con el lanzamiento, vaga 25 s alrededor del clic y lanza a lo que esta cerca de su pared. La zona cuenta el tiempo; Drift mueve la zona y fija el tamano; Lift levanta; Look dibuja. Mover la luz (Look/Light) con el gizmo."
script = ExtResource("1_zone")
spell = ExtResource("7_spell")
hold_is_spell_duration = true
end_s = 1.7
synced = PackedStringArray(".:position", "Drift:size")

[node name="Drift" type="Node" parent="." node_paths=PackedStringArray("zone")]
script = ExtResource("2_drift")
zone = NodePath("..")

[node name="Winds" type="Node" parent="." node_paths=PackedStringArray("zone")]
script = ExtResource("3_winds")
zone = NodePath("..")

[node name="Lift" type="Node" parent="." node_paths=PackedStringArray("zone", "drift", "winds")]
script = ExtResource("4_lift")
zone = NodePath("..")
drift = NodePath("../Drift")
winds = NodePath("../Winds")

[node name="Look" type="Node3D" parent="." node_paths=PackedStringArray("zone", "drift", "winds", "parts", "dust", "light")]
script = ExtResource("5_look")
zone = NodePath("..")
drift = NodePath("../Drift")
winds = NodePath("../Winds")
parts = [NodePath("Upper"), NodePath("Lower"), NodePath("Edge")]
dust = NodePath("Dust")
light = NodePath("Light")

[node name="Upper" type="MeshInstance3D" parent="Look"]
mesh = ExtResource("10_rings")
material_override = SubResource("Material_upper")
cast_shadow = 0

[node name="Lower" type="MeshInstance3D" parent="Look"]
mesh = ExtResource("10_rings")
material_override = SubResource("Material_lower")
cast_shadow = 0

[node name="Edge" type="MeshInstance3D" parent="Look"]
mesh = ExtResource("11_edge")
material_override = SubResource("Material_edge")
cast_shadow = 0

[node name="Dust" type="CPUParticles3D" parent="Look"]
use_fixed_seed = true
local_coords = false
script = ExtResource("6_emitter")
type = ExtResource("8_dust")
start_active = true

[node name="Light" parent="Look" instance=ExtResource("15_light")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 12, 0)
light_color = Color(0.85, 0.84, 0.8, 1)
light_energy = 1.3
omni_range = 35.0
priority = 3.0

[node name="CastSound" parent="." instance=ExtResource("16_sound")]
cue = &"tornado_cast"

[node name="WindSound" parent="." instance=ExtResource("16_sound")]
cue = &"tornado_loop"
loop = true
