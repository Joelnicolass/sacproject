[gd_scene load_steps=16 format=3]

[ext_resource type="Script" path="res://scenes/spells/wards/ward.gd" id="1_ward"]
[ext_resource type="Resource" path="res://spells/healing_aura/healing_aura.tres" id="2_spell"]
[ext_resource type="Resource" path="res://scenes/fx/effects/healing_aura_cast.tres" id="3_cast"]
[ext_resource type="Shader" path="res://scenes/spells/wards/aura_sphere.gdshader" id="4_shader"]
[ext_resource type="Texture2D" path="res://assets/original/fx/haur.png" id="5_veil"]
[ext_resource type="Script" path="res://scenes/spells/wards/body_aura.gd" id="6_aura"]
[ext_resource type="Script" path="res://scenes/spells/wards/ward_emitter.gd" id="7_emitter"]
[ext_resource type="Resource" path="res://scenes/fx/effects/healing_aura_glow.tres" id="8_glow"]
[ext_resource type="PackedScene" path="res://scenes/spells/wards/ward_sound.tscn" id="9_sound"]
[ext_resource type="PackedScene" path="res://scenes/look/lights/state_light.tscn" id="glow_state_light"]
[ext_resource type="Resource" path="res://scenes/audio/cues/ward_healing_aura.tres" id="cue_ward_healing_aura"]

[sub_resource type="ShaderMaterial" id="Mat_veil"]
shader = ExtResource("4_shader")
shader_parameter/veil = ExtResource("5_veil")

[sub_resource type="SphereMesh" id="Mesh_veil"]
material = SubResource("Mat_veil")
radius = 0.5
height = 1.0
radial_segments = 25
rings = 24

[sub_resource type="SphereShape3D" id="Sphere_reach"]
radius = 30.0

[node name="HealingAura" type="Node3D" node_paths=PackedStringArray("look")]
editor_description = "Healing Aura (ruah): la lleva una criatura aliada 20 s. Ella y toda criatura de su bando a <= 30 m (Aura/Reach, distancia entre cajas) se curan a 60/s; la cura sigue 256 ticks despues de salir. No protege (counts_as_shield apagado). El velo son tres capas de una esfera con ruido vista por dentro (aura_sphere.gdshader, haur); mide 1,9 x 1,45 x 1,9 veces la caja (look_scale) y crece y se achica en 30 ticks."
script = ExtResource("1_ward")
spell = ExtResource("2_spell")
counts_as_shield = false
cast_type = ExtResource("3_cast")
look = NodePath("Look")
grow_s = 0.5
look_scale = Vector3(1.9, 1.45, 1.9)

[node name="Look" type="Node3D" parent="."]
visible = false

[node name="Layer0" type="MeshInstance3D" parent="Look"]
cast_shadow = 0
mesh = SubResource("Mesh_veil")
metadata/instance_params = {"phase_frames": 0.0}

[node name="Layer1" type="MeshInstance3D" parent="Look"]
cast_shadow = 0
mesh = SubResource("Mesh_veil")
metadata/instance_params = {"phase_frames": 20.0}

[node name="Layer2" type="MeshInstance3D" parent="Look"]
cast_shadow = 0
mesh = SubResource("Mesh_veil")
metadata/instance_params = {"phase_frames": 40.0}

[node name="Aura" type="Node3D" parent="." node_paths=PackedStringArray("ward", "reach")]
script = ExtResource("6_aura")
ward = NodePath("..")
reach = NodePath("Reach")
affects = 3
heal_per_s = 60.0
include_owner = true

[node name="Reach" type="CollisionShape3D" parent="Aura"]
shape = SubResource("Sphere_reach")

[node name="Glow" type="CPUParticles3D" parent="." node_paths=PackedStringArray("ward")]
editor_description = "Chispas glo2 sobre la superficie mientras la lleva (el exe: glo2 aditivas con (3, 1,5, 2, 0,5, 2, 1): NO VERIFICADO el significado de cada numero)."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
use_fixed_seed = true
local_coords = false
script = ExtResource("7_emitter")
type = ExtResource("8_glow")
ward = NodePath("..")
when = 0
half_axes_m = Vector3(1.2, 1, 1.2)
on_surface = true

[node name="SoundLoop" parent="." node_paths=PackedStringArray("ward") instance=ExtResource("9_sound")]
editor_description = "aura.wav en bucle sobre la portadora (SPEL ruah: sonido aura, bandera de lazo)."
cue = ExtResource("cue_ward_healing_aura")
ward = NodePath("..")
when = 2

[node name="Glow" parent="." instance=ExtResource("glow_state_light")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 0)
light_color = Color(1, 0.9, 0.2, 1)
light_energy = 1.4
omni_range = 14
editor_description = "Golden light while the aura lasts (the exe gives Healing Aura a yellow light of 50 m; here a moderate 14 m). Every unit carries this ward: the light sleeps outside the budget until it shines. Tune color, energy and range here."

[connection signal="shown_changed" from="." to="Glow" method="show_lit"]
