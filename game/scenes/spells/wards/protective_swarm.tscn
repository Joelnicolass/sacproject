[gd_scene load_steps=13 format=3]

[ext_resource type="Script" path="res://scenes/spells/wards/ward.gd" id="1_ward"]
[ext_resource type="Script" path="res://scenes/spells/wards/ward_emitter.gd" id="2_emitter"]
[ext_resource type="Script" path="res://scenes/spells/wards/body_aura.gd" id="3_aura"]
[ext_resource type="Resource" path="res://data/catalog/spells/rwsp.tres" id="4_spell"]
[ext_resource type="Resource" path="res://data/fx/wards/swarm_bug.tres" id="5_bug"]
[ext_resource type="Resource" path="res://data/fx/wards/swarm_cast.tres" id="6_cast"]
[ext_resource type="Resource" path="res://data/fx/wards/swarm_sting.tres" id="7_sting"]
[ext_resource type="Script" path="res://scenes/spells/wards/aura_impact.gd" id="8_impact"]
[ext_resource type="PackedScene" path="res://scenes/spells/wards/ward_sound.tscn" id="9_sound"]
[ext_resource type="PackedScene" path="res://scenes/look/lights/state_light.tscn" id="glow_state_light"]

[sub_resource type="SphereShape3D" id="Sphere_reach"]
radius = 4.0

[node name="ProtectiveSwarm" type="Node3D"]
script = ExtResource("1_ward")
spell = ExtResource("4_spell")
factor = 0.75
cast_type = ExtResource("6_cast")

[node name="Bugs" type="CPUParticles3D" parent="." node_paths=PackedStringArray("ward")]
editor_description = "Los bichos pswm (SPEL rwsp: ttex = pswm). Los nacen sobre un elipsoide y vuelan; el original los hace ir de punto a punto."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.53, 0)
use_fixed_seed = true
local_coords = false
script = ExtResource("2_emitter")
type = ExtResource("5_bug")
ward = NodePath("..")
when = 0
half_axes_m = Vector3(2.04, 2.03, 2.04)
on_surface = true

[node name="BugsCast" type="CPUParticles3D" parent="." node_paths=PackedStringArray("ward")]
editor_description = "Mientras se lanza: los 150 bichos se reparten a lo largo del lanzamiento (sacengine los nace en las manos); aca la cuota sube de 0 a la plena sobre el torso."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.53, 0)
use_fixed_seed = true
local_coords = false
script = ExtResource("2_emitter")
type = ExtResource("5_bug")
ward = NodePath("..")
when = 3
half_axes_m = Vector3(0.6, 0.6, 0.6)
on_surface = false
ramp = true

[node name="Aura" type="Node3D" parent="." node_paths=PackedStringArray("ward", "reach")]
script = ExtResource("3_aura")
ward = NodePath("..")
reach = NodePath("Reach")
damage_per_s = 75.0
heal_owner_fraction = 0.5

[node name="Reach" type="CollisionShape3D" parent="Aura"]
shape = SubResource("Sphere_reach")

[node name="Impact" type="Node" parent="." node_paths=PackedStringArray("aura")]
editor_description = "Al picar: salpicadura de pus puss (SPEL rwsp: tSPK = puss, no aditiva) sobre la victima y los sonidos swr1-3, como mucho cada 1/3 s por victima. NO VERIFICADO: que la salpicadura sea al picar (el exe no muestra donde la llama el enjambre)."
script = ExtResource("8_impact")
aura = NodePath("../Aura")
type = ExtResource("7_sting")

[node name="SoundBuzz" parent="." node_paths=PackedStringArray("ward") instance=ExtResource("9_sound")]
editor_description = "buzz.wav es tfx2 del SPEL rwsp. NO VERIFICADO cuando suena: aca al prender el escudo."
cue = &"ward_swarm_buzz"
ward = NodePath("..")

[node name="SoundLoop" parent="." node_paths=PackedStringArray("ward") instance=ExtResource("9_sound")]
editor_description = "Lazo swr3 (3rws): desde el lanzamiento hasta que termina el escudo."
cue = &"ward_swarm_loop"
ward = NodePath("..")
when = 2

[node name="Glow" parent="." instance=ExtResource("glow_state_light")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 0)
light_color = Color(0.85, 1, 0.45, 1)
light_energy = 1
omni_range = 6
editor_description = "Yellow-green light while the swarm lasts (dominant colour of pswm.png, the bugs). Tune color, energy and range here."

[connection signal="shown_changed" from="." to="Glow" method="show_lit"]
