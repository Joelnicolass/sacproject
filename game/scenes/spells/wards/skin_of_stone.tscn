half_axes_m = Vector3(0.93, 1.38, 0.93)
on_surface = false

[node name="CastRing" type="CPUParticles3D" parent="." node_paths=PackedStringArray("ward")]
editor_description = "Mientras se lanza: 30 particulas dirt por tick en un anillo a ras del suelo, de radio 2 (s + 0,5), que se cierra hacia los pies (sacengine, SPEL niks: tcst = dirt). Cierra al 10 %: el original llega al 90 % en xy."
