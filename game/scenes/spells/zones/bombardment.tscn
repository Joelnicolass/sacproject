[node name="Bombardment" type="Node3D"]
editor_description = "Bombardment (rtem): sin nube. 2 meteoritos por segundo durante 20 s; cada uno sale de la tierra a <= 12,5 m del mago y cruza el cielo en un arco de 12 s hasta un punto del disco de 50 m alrededor del clic. Sin abolladuras (061k)."
script = ExtResource("zone")
spell = ExtResource("spell")
hold_is_spell_duration = true
end_s = 1.1

[node name="Dropper" type="Node" parent="." node_paths=PackedStringArray("zone")]
script = ExtResource("dropper")
zone = NodePath("..")
rate_per_s = 2
near_m = 10.0
far_m = 25.0
far_chance = 0.667

[node name="Launcher" type="Node" parent="." node_paths=PackedStringArray("zone", "dropper", "cloud_at")]
