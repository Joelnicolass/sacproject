[node name="DemonicRift" type="Node3D"]
editor_description = "Demonic Rift (tfir): una grieta de radio 2,5 m que sale del suelo en los pies del mago mientras lanza, suelta hasta 24 espiritus (uno cada 1/3 s) y se cierra al irse el ultimo. El borde oscurece (blend_sub, rif2); los remolinos (rif3) suben de la boca; los espiritus son RiftSpirit. Los numeros salen del SPEL: radio 2,5, alto 1,5 por 0,5 del radio."
script = ExtResource("1_zone")
spell = ExtResource("2_spell")
open_ended = true
end_s = 1.0

