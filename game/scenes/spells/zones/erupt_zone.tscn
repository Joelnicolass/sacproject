[node name="EruptZone" type="Node3D"]
editor_description = "Erupt (tpre): la tierra sube hasta 15 m en 50 m a la redonda mientras el mago lanza y hasta los 4,2 s del inicio; entonces cae (0,15 s), sale una onda de 90 m en 1 s, hace 600 de daño a 15 m, lanza hasta 42,5 m y la onda aturde entre 50 y 75 m. Los TerrainStamp (Mound, Rebound, Wave) son una función del tiempo: a los 5,2 s el suelo vuelve a ser el de antes. El radio y el pico de cada sello son su cilindro Reach (gizmo); las curvas se editan en su StampProfile."
script = ExtResource("1_zone")
spell = ExtResource("2_spell")
hold_s = 1.0
synced = PackedStringArray("Mound:synced_ticks", "Rebound:synced_ticks", "Wave:synced_ticks")
end_s = 0.1

