[node name="FrozenGround" type="Node3D"]
editor_description = "Frozen Ground (zorf): la bola de nieve crece junto al mago, vuela 2 s y cae; el hielo crece 0,5 s hasta 15 m y congela (con los numeros de Freeze) a cada no aliado en tierra, una vez; dura lo que dice el hechizo (30 s; el original fuerza 15) y se rompe en 6 pasos del centro hacia afuera haciendo 800 una vez a cada uno. Las duraciones salen del SPEL; solo `end_s` y `grow_s` son de la escena."
script = ExtResource("1_zone")
spell = ExtResource("2_spell")
hold_is_spell_duration = true
end_s = 0.5
grow_s = 0.5

[node name="Snowball" type="Node3D" parent="." node_paths=PackedStringArray("zone", "ball")]
script = ExtResource("3_flight")
zone = NodePath("..")
ball = NodePath("Ball")
trail = ExtResource("4_trail")
shards = Array[ExtResource("7_ptype")]([ExtResource("5_burst"), ExtResource("6_burst2")])

[node name="Ball" type="MeshInstance3D" parent="Snowball"]
cast_shadow = 0
mesh = ExtResource("mesh_sbll")

[node name="Ice" type="MeshInstance3D" parent="." node_paths=PackedStringArray("zone")]
editor_description = "El hielo pegado al suelo (icec, alfa 0,2, energia 10). El radio y lo ya roto los pone IcePatch por instancia. `lift_m`: a cuanta altura flota sobre el terreno."
material_override = SubResource("Mat_ice")
cast_shadow = 0
script = ExtResource("8_patch")
zone = NodePath("..")

