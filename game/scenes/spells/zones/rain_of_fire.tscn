[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://scenes/spells/zones/ground_zone.gd" id="zone"]
[ext_resource type="Resource" path="res://data/catalog/spells/rifr.tres" id="spell"]
[ext_resource type="PackedScene" path="res://scenes/spells/zones/zone_sound.tscn" id="sound"]
[ext_resource type="Script" path="res://scenes/spells/zones/cloud_look.gd" id="look"]
[ext_resource type="Shader" path="res://scenes/spells/zones/cloud_sphere.gdshader" id="shader"]
[ext_resource type="PackedScene" path="res://scenes/look/lights/actor_light.tscn" id="light"]
[ext_resource type="Script" path="res://scenes/spells/zones/zone_dropper.gd" id="dropper"]
[ext_resource type="Script" path="res://scenes/spells/zones/drop_launcher.gd" id="launcher"]

[sub_resource type="ShaderMaterial" id="Mat_cloud"]
shader = ExtResource("shader")
shader_parameter/layer_alpha = 0.15
shader_parameter/noise_amount = 0.096
shader_parameter/morph_s = 8.0

[sub_resource type="SphereMesh" id="Mesh_layer"]
material = SubResource("Mat_cloud")
radius = 0.5
height = 1.0
radial_segments = 24
rings = 12

[sub_resource type="MultiMesh" id="Layers_mm"]
transform_format = 1
use_custom_data = true
mesh = SubResource("Mesh_layer")

[node name="RainOfFire" type="Node3D"]
editor_description = "Rain of Fire (rifr): una nube negra de 25 m (la mitad del alcance) a 90 m sobre el clic; suelta 3 bolas de fuego por segundo durante 20 s. Cada una nace en el disco de 25 m de la nube y vuela sin gravedad en 1,4 s a un punto del disco de 50 m (o a una criatura)."
script = ExtResource("zone")
spell = ExtResource("spell")
hold_is_spell_duration = true
end_s = 1.1

[node name="CloudAt" type="Marker3D" parent="."]
editor_description = "Donde flota la nube sobre el suelo del clic (el original: 90 m). Las gotas nacen a esta altura."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 90.0, 0)

[node name="Cloud" type="Node3D" parent="CloudAt" node_paths=PackedStringArray("zone", "layers")]
script = ExtResource("look")
zone = NodePath("../..")
layers = NodePath("Layers")
radius_share = 0.5

[node name="Layers" type="MultiMeshInstance3D" parent="CloudAt/Cloud"]
cast_shadow = 0
multimesh = SubResource("Layers_mm")

[node name="Light" parent="CloudAt" instance=ExtResource("light")]
light_color = Color(1.0, 0.5, 0.15, 1)
light_energy = 1.2
omni_range = 40.0
priority = 3.0

[node name="Dropper" type="Node" parent="." node_paths=PackedStringArray("zone")]
script = ExtResource("dropper")
zone = NodePath("..")
rate_per_s = 3
near_m = 10.0
far_m = 25.0
far_chance = 0.667

[node name="Launcher" type="Node" parent="." node_paths=PackedStringArray("zone", "dropper", "cloud_at")]
script = ExtResource("launcher")
zone = NodePath("..")
dropper = NodePath("../Dropper")
kind = "FireDrop"
start = 1
cloud_at = NodePath("../CloudAt")
disk_share = 0.5
fall_s = 1.4

[node name="Sound0" parent="CloudAt" node_paths=PackedStringArray("zone") instance=ExtResource("sound")]
cue = &"explosion_loop"
loop = true
zone = NodePath("../..")
from_phase = 0
to_phase = 2

[node name="Sound1" parent="CloudAt" node_paths=PackedStringArray("zone") instance=ExtResource("sound")]
cue = &"cloud_loop"
loop = true
zone = NodePath("../..")
from_phase = 0
to_phase = 2
