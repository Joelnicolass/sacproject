[node name="RiftSpirit" type="Node3D" node_paths=PackedStringArray("hit_sound", "spawn_sound")]
editor_description = "Un espiritu de Demonic Rift (SPEL tfir: tdtx = rift). La cinta son las ultimas 120 posiciones (una de cada 3), 0,6 m de ancho, con las tiras de rift estiradas a lo largo y aditiva. Los numeros de vuelo salen del hechizo (velocidad 18, aceleracion 1,2, 500 de dano)."
