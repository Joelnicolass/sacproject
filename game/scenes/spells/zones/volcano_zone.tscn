[node name="CloudAt" type="Marker3D" parent="."]
editor_description = "Donde esta el humo (a unos 470 m, encima del embudo de la columna que llega a 310 m): la camara de capturas (match_shots --views=cloud) mira a medio camino entre el suelo y este punto."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 470, 0)

[node name="Smoke" type="Node3D" parent="CloudAt" node_paths=PackedStringArray("zone", "layers")]
editor_description = "El humo sobre la columna: las capas de esfera ruidosa de las nubes de 061h (cloud_sphere.gdshader), con altura (un monton de esferas de 230 m de radio sobre el embudo), de nucleo casi negro y bordes grises; solo su cara de abajo toma el naranja de la lava. VolcanoLook las muestra solo desde la erupcion."
script = ExtResource("30_cloud")
zone = NodePath("../..")
layers = NodePath("Layers")
fixed_radius_m = 230.0
shape = Vector3(1.5, 0.5, 1.5)

