[node name="VolcanoZone" type="Node3D"]
editor_description = "Volcano (clov): el monte sube mientras el mago lanza (4,44 s) y a esa hora erupciona: un crater de 25 m y 10 m de hondo, 1000 de dano en 50 m, una columna de lava de 310 m, humo y bolas de lava (una cada 32 ticks de media) durante 60 s. En ese tiempo el monte baja al 25 % y eso queda. Los TerrainStamp son el monte (la imagen volcano_shape.png, aplanado a la altura del centro) y el crater; sus Reach se mueven con el gizmo. Si el lanzamiento se corta, el suelo vuelve exacto a como estaba. La luz naranja es la de la lava (la erupcion lleva su FxLightSpec en volcano_ash_burst.tres)."
script = ExtResource("1_zone")
spell = ExtResource("2_spell")
hold_is_spell_duration = true
synced = PackedStringArray("Mound:synced_ticks", "Crater:synced_ticks")
synced_on_change = PackedStringArray("Mound:pattern")
end_s = 2.0

[node name="Mound" type="Node3D" parent="." node_paths=PackedStringArray("reach")]
editor_description = "El monte: la imagen volcano_shape.png (33 x 33, blanco = 51 m) por 0,2 y el aplanado hacia la altura del centro (plano hasta 80 m, se pierde hasta 160 m). Sube con el lanzamiento, baja al 25 % en 60 s y eso queda para siempre."
script = ExtResource("3_stamp")
profile = SubResource("Profile_mound")
reach = NodePath("Reach")
keep = true

[node name="Reach" type="CollisionShape3D" parent="Mound"]
shape = SubResource("Reach_mound")

[node name="Crater" type="Node3D" parent="." node_paths=PackedStringArray("reach")]
editor_description = "El crater: 25 m de radio y 10 m de hondo, en el momento de la erupcion; queda para siempre."
script = ExtResource("3_stamp")
profile = SubResource("Profile_crater")
reach = NodePath("Reach")
start_s = 4.4444
keep = true

[node name="Reach" type="CollisionShape3D" parent="Crater"]
shape = SubResource("Reach_crater")

[node name="Cut" type="Node" parent="." node_paths=PackedStringArray("zone", "stamps")]
editor_description = "Si el lanzamiento se corta, el suelo vuelve de golpe (los sellos se retiran en el momento, sin esperar a que la zona se libere)."
script = ExtResource("27_stop")
zone = NodePath("..")
stamps = [NodePath("../Mound"), NodePath("../Crater")]

[node name="Burn" type="Node" parent="." node_paths=PackedStringArray("zone")]
editor_description = "La quemadura: 1000 de dano por segundo hasta 20 m, que cae a nada a 50 m; prende fuego y empuja 5 m/s hacia afuera, mas cuanto mas cerca."
script = ExtResource("6_heat")
zone = NodePath("..")
damage_share = 1.0
burn_s = 0.5
burn_look = ExtResource("7_fire")
push_m_s = 5.0

[node name="Push" type="Node" parent="." node_paths=PackedStringArray("zone")]
editor_description = "El empuje lento: de 10 a 50 m, 1/3 m/s hacia afuera (en 3D) sobre todo lo que vive."
script = ExtResource("6_heat")
zone = NodePath("..")
full_m = 10.0
push_m_s = 0.3333
push_flat = false

[node name="Eruption" type="Node" parent="." node_paths=PackedStringArray("zone")]
editor_description = "La erupcion, una vez: 1000 de dano que cae a nada a 50 m, 64 pedazos de ceniza con la luz de la erupcion y la marca volc en el suelo."
script = ExtResource("8_burst")
zone = NodePath("..")
puffs = Array[ExtResource("12_ptype")]([ExtResource("9_ash_burst")])
marks = Array[PackedScene]([ExtResource("11_mark")])
