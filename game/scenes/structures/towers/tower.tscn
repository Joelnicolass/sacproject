[node name="BaseSpot" type="Marker3D" parent="."]
editor_description = "Where the start and the end of the cast are born (BuildCues): move it with the gizmo."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 0)

[node name="BuildCues" type="Node" parent="." node_paths=PackedStringArray("tower", "reveal", "spot")]
editor_description = "The start (a tower at the bottom), the end (it stands) and the cut (it goes away rising) of the cast: each a list of ParticleType (look, light, sound, shake), played on this peer only. An empty list = nothing."
script = ExtResource("14_cues")
tower = NodePath("..")
reveal = NodePath("../BuildReveal")
spot = NodePath("../BaseSpot")
start_fx = Array[ExtResource("1_type_pt")]([ExtResource("15_start")])
done_fx = Array[ExtResource("1_type_pt")]([ExtResource("16_done"), ExtResource("17_sparks")])
cut_fx = Array[ExtResource("1_type_pt")]([ExtResource("18_cut")])

[node name="BuildEdge" type="Node3D" parent="." node_paths=PackedStringArray("tower", "reveal", "rings", "light")]
editor_description = "Rides the cut line while the tower rises: EdgeRings throws flat blue rings (data/fx/build_edge_ring.tres), EdgeLight grows with build_progress along energy_curve and fades out when the tower stands."
script = ExtResource("10_edge")
tower = NodePath("..")
reveal = NodePath("../BuildReveal")
rings = NodePath("EdgeRings")
light = NodePath("EdgeLight")
energy_curve = SubResource("Curve_edge_energy")

[node name="EdgeRings" parent="BuildEdge" instance=ExtResource("11_emitter")]
