[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/ui/character_select.gd" id="1_select"]
[ext_resource type="PackedScene" path="res://scenes/ui/pick_button.tscn" id="2_button"]
[ext_resource type="PackedScene" path="res://scenes/ui/wizard_preview.tscn" id="3_preview"]

[node name="CharacterSelect" type="MarginContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24
script = ExtResource("1_select")
pick_button = ExtResource("2_button")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Choices" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Row/Choices"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Elegí tu mago"

[node name="WizardGrid" type="GridContainer" parent="Row/Choices"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 5

[node name="GodTitle" type="Label" parent="Row/Choices"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Elegí tu dios"

[node name="GodRow" type="HBoxContainer" parent="Row/Choices"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="BookTitle" type="Label" parent="Row/Choices"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Libro inicial"

[node name="Book" type="Label" parent="Row/Choices"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Side" type="VBoxContainer" parent="Row"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="WizardPreview" parent="Row/Side" instance=ExtResource("3_preview")]
unique_name_in_owner = true
layout_mode = 2

[node name="WizardName" type="Label" parent="Row/Side"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1

[node name="WizardStats" type="Label" parent="Row/Side"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Row/Side"]
layout_mode = 2
size_flags_vertical = 3

[node name="Play" type="Button" parent="Row/Side"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Jugar"
