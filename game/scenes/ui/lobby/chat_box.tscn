[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/lobby/chat_box.gd" id="1_chat"]

[node name="ChatBox" type="VBoxContainer"]
custom_minimum_size = Vector2(320, 0)
theme_override_constants/separation = 6
script = ExtResource("1_chat")

[node name="ChatTitle" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "UI_CHAT_BOX_CHAT_TITLE"

[node name="ChatLog" type="RichTextLabel" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 220)
layout_mode = 2
size_flags_vertical = 3
scroll_following = true

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ChatLine" type="LineEdit" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "UI_CHAT_BOX_CHAT_LINE_HINT"

[node name="ChatSend" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
text = "UI_CHAT_BOX_CHAT_SEND"
