[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scenes/ui/lobby/lobby_screen.gd" id="1_screen"]
[ext_resource type="PackedScene" path="res://scenes/ui/lobby/lobby_connect.tscn" id="2_connect"]
[ext_resource type="PackedScene" path="res://scenes/ui/lobby/room_list.tscn" id="3_list"]
[ext_resource type="PackedScene" path="res://scenes/ui/lobby/room_create.tscn" id="4_create"]
[ext_resource type="PackedScene" path="res://scenes/ui/lobby/room_view.tscn" id="5_room"]
[ext_resource type="Resource" path="res://data/net/lobby_endpoint.tres" id="6_endpoint"]
[ext_resource type="Script" path="res://scenes/net/online_network.gd" id="8_onlinenet"]

[node name="LobbyScreen" type="Control" node_paths=PackedStringArray("online")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")
endpoint = ExtResource("6_endpoint")
online = NodePath("OnlineNetwork")

[node name="LobbyConnect" parent="." instance=ExtResource("2_connect")]
unique_name_in_owner = true
layout_mode = 1

[node name="RoomList" parent="." instance=ExtResource("3_list")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[node name="RoomCreate" parent="." instance=ExtResource("4_create")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[node name="RoomView" parent="." instance=ExtResource("5_room")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[node name="Notice" type="Label" parent="."]
theme_type_variation = &"LabelOutlineHeavy"
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -360.0
offset_top = -64.0
offset_right = 360.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="NoticeTimer" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true

[node name="OnlineNetwork" type="Node" parent="."]
script = ExtResource("8_onlinenet")
