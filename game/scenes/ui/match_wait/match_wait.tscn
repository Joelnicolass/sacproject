editor_description = "Cartel de la partida en red que todavía no arrancó: «Esperando jugadores k/n» mientras la puerta espera que carguen los asientos. «Empezar ya» se ve solo en el host LAN con al menos un cliente cargado. Corre con el árbol pausado. Borrarlo quita el cartel; la espera sigue igual."
script = ExtResource("1_wait")

