[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/options/advanced_tab.gd" id="1_tab"]
[ext_resource type="Resource" path="res://scenes/ui/graphics_prefs.tres" id="2_prefs"]

[node name="AdvancedTab" type="VBoxContainer"]
theme_type_variation = &"VBoxForm"
custom_minimum_size = Vector2(520, 0)
script = ExtResource("1_tab")
prefs = ExtResource("2_prefs")

[node name="Hint" type="Label" parent="."]
layout_mode = 2
text = "UI_ADVANCED_HINT"
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="ResetAll" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "UI_ADVANCED_RESET_ALL"
