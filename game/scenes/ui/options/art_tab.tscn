[node name="Save" type="Button" parent="SaveRow"]
unique_name_in_owner = true
layout_mode = 2
text = "UI_ART_SAVE"

[node name="Export" type="Button" parent="SaveRow"]
unique_name_in_owner = true
layout_mode = 2
text = "UI_ART_EXPORT"

[node name="LoadRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Saved" type="OptionButton" parent="LoadRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Load" type="Button" parent="LoadRow"]
unique_name_in_owner = true
layout_mode = 2
text = "UI_ART_LOAD"

[node name="ResetAll" type="Button" parent="LoadRow"]
unique_name_in_owner = true
layout_mode = 2
text = "UI_ART_RESET_ALL"

[node name="Status" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
