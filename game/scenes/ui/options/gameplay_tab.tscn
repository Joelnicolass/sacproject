[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/options/gameplay_tab.gd" id="1_tab"]
[ext_resource type="Resource" path="res://data/ui/gameplay_prefs.tres" id="2_prefs"]

[node name="GameplayTab" type="VBoxContainer"]
custom_minimum_size = Vector2(360, 0)
theme_override_constants/separation = 10
