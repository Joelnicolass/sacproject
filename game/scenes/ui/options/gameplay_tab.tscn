[node name="DropSoul" type="CheckButton" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Soltar almas con P"

[node name="SoulsRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="SoulsLabel" type="Label" parent="SoulsRow"]
