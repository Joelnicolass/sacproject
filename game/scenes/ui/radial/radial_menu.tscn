[node name="RadialMenu" type="Control" node_paths=PackedStringArray("decor", "rings", "animator")]
editor_description = "RFC-038 038c: radial menu of two rings. It shows the entries of its RadialLayout and emits entry_chosen / cancelled; OrderRadial feeds it the pointer. preview_open shows it in the editor; F6 runs it alone. Look: Decor; icons: Rings; open / close: Animator (clips open and close)."
layout_mode = 3
anchors_preset = 0
offset_right = 336.0
offset_bottom = 336.0
mouse_filter = 2
script = ExtResource("1_menu")
layout = ExtResource("2_layout")
decor = NodePath("Decor")
rings = NodePath("Rings")
animator = NodePath("Animator")

[node name="Decor" type="Control" parent="." node_paths=PackedStringArray("center_rect")]
editor_description = "Draws the rings, the hovered sector, the pointer line and the name in the dead zone. Colors and sizes are its Look group."
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_decor")
center_rect = NodePath("../Center")

[node name="Center" type="TextureRect" parent="."]
texture_filter = 1
layout_mode = 0
offset_left = 127.0
offset_top = 127.0
offset_right = 209.0
offset_bottom = 209.0
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Rings" type="Control" parent="."]
layout_mode = 3
anchors_preset = 0
mouse_filter = 2
script = ExtResource("4_rings")

[node name="MenuSounds" type="Node" parent="." node_paths=PackedStringArray("menu")]
editor_description = "Lo que suena al abrir, elegir una entrada y cerrar sin elegir del menú X: tres SoundCue (data/audio/cues/). Vaciá uno y ese momento queda en silencio. Sin audio no hace nada."
script = ExtResource("a052_menu_sounds")
menu = NodePath("..")
opened = ExtResource("a055_open")
chosen = ExtResource("a055_chosen")
cancelled = ExtResource("a055_back")

[node name="Animator" type="AnimationPlayer" parent="."]
editor_description = "Clip open: escala 0,7 a 1 y aparece (0,12 s). Clip close: se desvanece (0,08 s)."
libraries = {
"": SubResource("AnimationLibrary_radial")
}
script = ExtResource("5_animator")

[node name="Standalone" type="Node" parent="." node_paths=PackedStringArray("menu")]
editor_description = "Solo F6 sobre esta escena: la abre en el medio y la mueve con el mouse. Dentro de una partida no hace nada."
script = ExtResource("6_standalone")
menu = NodePath("..")
