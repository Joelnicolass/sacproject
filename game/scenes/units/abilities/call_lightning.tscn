[node name="CallLightning" type="Node"]
editor_description = "The Storm Giant's Call lightning effect (gsba). AbilitySlot instances it as \"Effect\" from the effect field of its AbilityType (data/catalog/abilities/). No preparation and no cooldown; it throws a LightningStrike `ntil` (750) from a point of the sky to the Giant's own center (it bounces on the first body in the way)."
