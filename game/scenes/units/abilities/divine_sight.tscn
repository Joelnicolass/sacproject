[node name="DivineSight" type="Node"]
editor_description = "The Ranger's Divine Sight effect (eesd). AbilitySlot instances it as \"Effect\" from the effect field of its AbilityType (data/catalog/abilities/). No target and no preparation: it throws the eye (divine_sight_eye.tscn) 2 m ahead of the user, where it faces, at the SPEL's speed (30 m/s). AbilitySlot charges the mana (50) and the cooldown (25 s)."
script = ExtResource("1_sight")
