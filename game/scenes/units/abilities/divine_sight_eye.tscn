[node name="DivineSightEye" type="Node3D" node_paths=PackedStringArray("glow", "vision")]
editor_description = "F165 (RFC-030): el ojo del Divine Sight del Ranger (eesd). DivineSight (AbilityEffect) lo crea en el ShotSpawner (spawn_scene); lo simula solo el servidor (sube 45 ticks hasta 4 m, vuela recto a 30 m/s hasta 250 m o fija a la criatura enemiga más cercana a 250 m y la persigue con aceleración 3, su Vision (hijo) ve a las criaturas enemigas a 75 m para su lado, vive 30 s) y los clientes reciben posición y escala. Look: el sprite scri del original (hoja 4x4 de 16 cuadros, assets/original/fx/scri.png, tools/import/import_ui.py) en un quad de 2,5 x 2,25 m, sin sombreado, energía 3 (albedo_color), transparente con alfa = escala²; el script corre los cuadros por uv1_offset (frames_h, frames_v, frame_s). Knobs: flying_height, rising_s, refresh_s, target_groups."
script = ExtResource("1_eye")
glow = NodePath("Glow")
vision = NodePath("Vision")

[node name="Glow" type="MeshInstance3D" parent="."]
cast_shadow = 0
mesh = SubResource("Mesh_eye")
material_override = SubResource("Mat_eye")

[node name="Vision" parent="." node_paths=PackedStringArray("body") instance=ExtResource("3_vision")]
body = NodePath("..")
