[node name="HaloOfEarth" type="Node3D"]
process_physics_priority = -1
editor_description = "The coordinator of the Rhinok's Halo of Earth (HRba). HaloOfEarthAbility adds it to the shot container, on the server only. It simulates the 6 rocks (orbit, target, chase, hit and life) and moves their RangedShots (look halo_rock). Knobs: spawn_box_scale, ground_grace_s, life_s. It frees itself when all of them have blown up."
