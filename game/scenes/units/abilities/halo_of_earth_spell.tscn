[node name="HaloOfEarth" instance=ExtResource("1_halo")]
editor_description = "Halo of Earth del mago (olah): el mismo coordinador que el del Rhinok. LaunchAction lo crea al empezar el lanzamiento (las rocas salen escalonadas, floor((progreso + 0.1) x 6), y solo orbitan) y lo suelta al terminar. Las rocas nacen en la caja del mago x2,5."
