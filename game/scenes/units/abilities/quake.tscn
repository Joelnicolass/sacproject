[node name="Quake" type="Node"]
editor_description = "The Jabberocky's Quake effect (kauq). AbilitySlot instances it as \"Effect\" from the effect field of its AbilityType (data/catalog/abilities/). It prepares the shoot0 clip (192 ticks, windup_clip 0), charges the mana (300) at the start (pays_upfront) and, on the shot, creates a QuakeWave at the user's feet; the cooldown (10 s) is set then if it was 0. No target."
script = ExtResource("1_ability")
windup_from_clip = true
windup_clip = 0
pays_upfront = true
wave_scene = ExtResource("2_wave")
