[node name="QuakeWave" type="Node3D"]
process_physics_priority = -1
editor_description = "The coordinator of the Jabberocky's Quake (kauq). Quake adds it to the shot container, on the server only, at the user's feet. It discards the tick it is born on; from frame 1 to 5 the wave (1.667·f m) stuns for 480 every moving body of any side whose box is within wave + 0.1, farther than 0.5 m flat and within 2.5 m of the wave. No damage. It frees itself on frame 31. Knobs: wave_range, wave_s, stun_min, stun_max, band, cooldown_s, life_s, groups."
script = ExtResource("1_wave")
ring_scene = ExtResource("2_ring")
dust_fx = ExtResource("fx_dirt")

[node name="Ground" parent="." instance=ExtResource("3_ground")]
editor_description = "The sinking land and the wave (two TerrainStamps). The server (or solo) plays it; the bodies follow it. A client sees it through the copy in QuakeRing."
