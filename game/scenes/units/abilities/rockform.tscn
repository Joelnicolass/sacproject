[node name="Rockform" type="Node"]
editor_description = "The Earthfling's Rockform effect (dihk). AbilitySlot instances it as \"Effect\" from the effect field of its AbilityType (data/catalog/abilities/). It turns to rock on the tick of the order and wears the rock_shell.tscn shell at the CENTER socket (show_rock_form, every peer; never on the dedicated server). The emerge_fx burst comes out of emerge_socket."
