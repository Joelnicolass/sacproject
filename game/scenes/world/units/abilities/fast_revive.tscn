[node name="FastRevive" type="Node"]
editor_description = "F153 (RFC-030 030p-b): revivir rapido del cuerpo caido por el Breath of life. BreathOfLife lo agrega como hijo del cuerpo, solo en el servidor, despues de begin(). Dura 150 ticks: sube 2 m / 75 por tick mientras timer < 75 (1,97 m), gira 2 pi; al final quita el alma y deja el cuerpo en IDLE (Captive.finish_revive)."
script = ExtResource("1_revive")
